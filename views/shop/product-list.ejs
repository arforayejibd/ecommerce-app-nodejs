<%- include('../includes/head.ejs') %>
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main style="padding-bottom: 4rem;">
        <!-- Page Header -->
        <div style="margin: 1.5rem 0 2rem; padding-bottom: 1.25rem; border-bottom: 1.5px solid #f1f5f9; display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #e11d48; margin-bottom: 0.35rem;"><%= typeof __ !== 'undefined' ? __('Explore Collection') : 'Explore Collection' %></div>
                <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; letter-spacing: -0.5px; margin: 0;"><%= (typeof categoryName !== 'undefined' && categoryName) ? categoryName : (typeof __ !== 'undefined' ? __('All Products') : 'All Products') %></h1>
            </div>
            <div style="font-size: 0.875rem; font-weight: 600; color: #64748b;">
                <%= typeof __ !== 'undefined' ? __('Products') : 'Items' %>: <strong><%= prods.length %></strong>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="product-grid">
            <% if (prods.length > 0) { %>
                <% prods.forEach(product => { %>
                    <div class="product_item">
                        <% if (product.oldPrice && product.oldPrice > product.price) { %>
                            <% const discount = Math.round(((product.oldPrice - product.price) / product.oldPrice) * 100); %>
                            <div class="sale-badge">-<%= discount %>%</div>
                        <% } %>
                        <% if (product.isFreeDelivery) { %>
                            <div class="free-delivery-badge desktop-only-badge"><i class="fa-solid fa-truck-fast"></i> <%= typeof __ !== 'undefined' ? __('Free Delivery') : 'Free Delivery' %></div>
                        <% } %>
                        
                        <div class="pro_img">
                            <a href="/products/<%= product.id %>">
                                <img src="<%= product.imageUrl %>" alt="<%= product.title %>" loading="lazy">
                            </a>
                        </div>

                        <div class="pro_des">
                            <% if (product.isFreeDelivery) { %>
                                <div class="free-delivery-badge mobile-only-badge"><i class="fa-solid fa-truck-fast"></i> <%= typeof __ !== 'undefined' ? __('Free Delivery') : 'Free Delivery' %></div>
                            <% } %>
                            <div class="pro_name">
                                <a href="/products/<%= product.id %>"><%= product.title %></a>
                            </div>
                            <div class="pro_price">
                                <span>৳ <%= product.price %></span>
                                <% if (product.oldPrice) { %>
                                    <del>৳ <%= product.oldPrice %></del>
                                <% } %>
                            </div>
                        </div>

                        <div class="pro_btn">
                            <form action="/cart" method="POST">
                                <input type="hidden" name="productId" value="<%= product.id %>">
                                <button type="submit">🛒 <%= typeof __ !== 'undefined' ? __('Order Now') : 'Order Now' %></button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 5rem 1rem; background: #ffffff; border-radius: 20px; border: 1px solid #e2e8f0;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
                    <h2 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">No products found!</h2>
                    <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem;">Try browsing other categories or search terms.</p>
                    <a href="/products" style="background: #0f172a; color: #fff; text-decoration: none; padding: 0.7rem 1.5rem; border-radius: 50px; font-weight: 700; font-size: 0.875rem;">View All Products</a>
                </div>
            <% } %>
        </div>
    </main>

<%- include('../includes/end.ejs') %>