<%- include('../includes/head.ejs') %>
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <div style="max-width: 600px; margin: 2rem auto; background: var(--bg-card); backdrop-filter: blur(12px); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-glow);">
            <h1 style="font-size: 1.8rem; font-weight: 800; text-align: center; margin-bottom: 0.5rem; color: var(--accent-blue);">🚚 Track Your Order</h1>
            <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">Enter your Order ID below to check current order status and details.</p>

            <form action="/order-track" method="GET" style="display: flex; gap: 0.5rem; margin-bottom: 2rem;">
                <input type="text" name="orderId" placeholder="Example: 1, 2, 3..." value="<%= typeof orderId !== 'undefined' ? orderId : '' %>" style="flex: 1; padding: 0.75rem 1rem; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-main); border-radius: var(--radius-sm); outline: none; font-size: 1rem;" required>
                <button type="submit" class="btn" style="width: auto; padding: 0.75rem 1.5rem;">Track</button>
            </form>

            <% if (searched) { %>
                <% if (order) { %>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                            <span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-blue);">Order #<%= order.id %></span>
                            <span style="background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.3rem 0.8rem; border-radius: 50px; font-weight: 700; font-size: 0.85rem;">✓ Confirmed</span>
                        </div>

                        <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
                            Date: <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </p>

                        <div style="background: var(--bg-secondary); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; border: 1px solid var(--border-color);">
                            <h4 style="margin-bottom: 0.5rem; font-size: 1rem;">Ordered Items:</h4>
                            <ul style="list-style: none; padding-left: 0;">
                                <% order.products.forEach(p => { %>
                                    <li style="display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid var(--border-color);">
                                        <span><%= p.title %> (x<%= p.orderItem.quantity %>)</span>
                                        <span style="font-weight: 700; color: var(--accent-blue);">৳ <%= p.price * p.orderItem.quantity %></span>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                    </div>
                <% } else { %>
                    <div style="text-align: center; color: #f87171; padding: 1rem; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-sm);">
                        ❌ Sorry, no order was found with this Order ID.
                    </div>
                <% } %>
            <% } %>
        </div>
    </main>

<%- include('../includes/end.ejs') %>
