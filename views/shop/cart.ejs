<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<style>
    /* 100% Exact Rosedrape Customer Checkout Page Styling */
    body {
        background-color: #f8fafc !important;
        font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
    }

    .checkout-section-wrapper {
        max-width: 1320px;
        margin: 2rem auto 3.5rem;
        padding: 0 1rem;
    }

    .checkout-grid-row {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 2rem;
    }

    @media (max-width: 992px) {
        .checkout-grid-row {
            grid-template-columns: 1fr;
        }
    }

    .card-checkout-box {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .card-header-notice {
        background: rgba(254, 82, 0, 0.06);
        border-bottom: 1px solid rgba(254, 82, 0, 0.15);
        padding: 0.85rem 1rem;
        font-size: 0.88rem;
        color: #334155;
        line-height: 1.5;
    }

    .card-header-notice h6 {
        font-size: 0.88rem;
        font-weight: 600;
        margin: 0;
        line-height: 1.5;
    }

    .card-header-title {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.1rem 1.25rem;
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
    }

    .card-body-content {
        padding: 1.5rem;
    }

    .form-group-mb {
        margin-bottom: 1.2rem;
    }

    .form-label-txt {
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.4rem;
    }

    .form-ctrl-input {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.95rem;
        outline: none;
        background: #ffffff;
        transition: border-color 0.2s ease;
    }

    .form-ctrl-input:focus {
        border-color: #fe5200;
    }

    .payment-method-heading {
        font-weight: 800;
        font-size: 0.95rem;
        color: #0f172a;
        margin-bottom: 0.75rem;
        display: block;
    }

    .payment-btn-tiles-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    @media (max-width: 576px) {
        .payment-btn-tiles-grid {
            grid-template-columns: 1fr;
        }
    }

    .payment-tile-card {
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.65rem 0.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #475569;
        background: #f8fafc;
        min-height: 72px;
    }

    .payment-tile-card.active, .payment-tile-card:hover {
        border-color: #fe5200;
        background: rgba(254, 82, 0, 0.05);
        color: #fe5200;
    }

    .btn-submit-order-big {
        width: 100%;
        background: linear-gradient(135deg, #fe5200 0%, #eb3b5a 100%);
        color: white;
        border: none;
        padding: 1rem;
        border-radius: 12px;
        font-size: 1.25rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 4px 18px rgba(254, 82, 0, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        transition: transform 0.2s ease;
    }

    .btn-submit-order-big:hover {
        transform: translateY(-2px);
    }

    /* Cart Table Styles */
    .cart-summary-table {
        width: 100%;
        border-collapse: collapse;
    }

    .cart-summary-table th {
        background: #f8fafc;
        padding: 0.85rem;
        text-align: left;
        font-size: 0.85rem;
        font-weight: 800;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
    }

    .cart-summary-table td {
        padding: 1rem 0.85rem;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .cart-prod-flex {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .cart-prod-img {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #e2e8f0;
    }

    .qty-counter-sm {
        display: inline-flex;
        align-items: center;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        overflow: hidden;
    }

    .qty-btn-btn {
        width: 28px;
        height: 28px;
        background: white;
        border: none;
        font-weight: 800;
        cursor: pointer;
    }

    .qty-val-txt {
        width: 32px;
        height: 28px;
        border: none;
        text-align: center;
        font-weight: 800;
        font-size: 0.88rem;
    }

    .btn-remove-item {
        background: #fee2e2;
        color: #ef4444;
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.85rem;
        margin: 0 auto;
    }

    .summary-calc-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0.85rem;
        font-size: 0.95rem;
        color: #334155;
    }

    .summary-calc-total {
        border-top: 2px dashed #cbd5e1;
        padding-top: 1rem;
        font-size: 1.3rem;
        font-weight: 900;
        color: #fe5200;
    }

    /* Mobile Sticky Order Bar (100% Exact Match to Product Detail Page) */
    .mobile-sticky-bar {
        display: none;
        align-items: center;
        gap: 0.75rem;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
        box-shadow: 0 -2px 0 #f1f5f9, 0 -8px 32px rgba(15, 23, 42, 0.12);
        z-index: 1500;
    }

    .sticky-info-col {
        display: flex;
        flex-direction: column;
        flex: 0 0 auto;
    }

    .sticky-price-label {
        font-size: 0.6rem;
        color: #94a3b8;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .sticky-price-val {
        font-size: 1.2rem;
        font-weight: 900;
        color: #e11d48;
        line-height: 1.2;
    }

    .sticky-order-btn {
        flex: 1;
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
        color: white;
        border: none;
        padding: 0.78rem 1rem;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 4px 18px rgba(225, 29, 72, 0.38);
        transition: transform 0.1s, box-shadow 0.18s;
        white-space: nowrap;
        letter-spacing: 0.2px;
    }

    .sticky-order-btn:active {
        transform: scale(0.96);
        box-shadow: 0 2px 8px rgba(225, 29, 72, 0.28);
    }

    .cart-table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @media (max-width: 768px) {
        .checkout-section-wrapper {
            margin: 0.5rem auto 2.5rem;
            padding: 0 0.5rem;
            padding-bottom: 90px;
        }

        .checkout-grid-row {
            gap: 0.85rem;
            display: flex;
            flex-direction: column-reverse;
        }

        .card-checkout-box {
            border-radius: 12px;
        }

        .card-header-notice {
            padding: 0.65rem 0.85rem;
            font-size: 0.78rem;
        }

        .card-header-title {
            padding: 0.75rem 0.85rem;
            font-size: 0.98rem;
        }

        .card-body-content {
            padding: 0.85rem !important;
        }

        .form-group-mb {
            margin-bottom: 0.75rem;
        }

        .form-label-txt {
            font-size: 0.82rem;
            margin-bottom: 0.25rem;
        }

        .form-ctrl-input {
            padding: 0.65rem 0.85rem;
            font-size: 0.88rem;
            border-radius: 8px;
        }

        .payment-method-heading {
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .payment-btn-tiles-grid {
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 0.5rem !important;
            margin-bottom: 0.5rem !important;
        }

        .payment-tile-card {
            min-height: 54px !important;
            padding: 0.4rem 0.25rem !important;
            font-size: 0.74rem !important;
            border-radius: 8px !important;
        }

        .cart-summary-table {
            width: 100%;
            min-width: 320px;
        }

        .cart-summary-table th {
            padding: 0.5rem 0.25rem;
            font-size: 0.75rem;
        }

        .cart-summary-table td {
            padding: 0.55rem 0.25rem;
            font-size: 0.78rem;
        }

        .cart-summary-table th:last-child,
        .cart-summary-table td:last-child {
            padding-right: 0.35rem !important;
            padding-left: 0.2rem !important;
            width: 32px;
            text-align: center;
        }

        .qty-btn-btn {
            width: 22px;
            height: 24px;
            font-size: 0.75rem;
        }

        .qty-val-txt {
            width: 24px;
            height: 24px;
            font-size: 0.78rem;
        }

        .btn-remove-item {
            width: 24px;
            height: 24px;
            font-size: 0.72rem;
        }

        .cart-prod-img {
            width: 36px;
            height: 36px;
            border-radius: 6px;
        }

        .cart-prod-flex {
            gap: 0.4rem;
        }

        .cart-prod-flex strong {
            font-size: 0.78rem !important;
            line-height: 1.3;
        }

        .summary-calc-row {
            padding: 0.5rem 0.4rem;
            font-size: 0.85rem;
        }

        .summary-calc-total {
            font-size: 1.1rem;
            padding-top: 0.65rem;
        }

        .btn-submit-order-big.desktop-place-order-btn {
            display: none !important;
        }

        .mobile-sticky-bar {
            display: flex !important;
        }
    }
</style>
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <% 
      let calcSubtotal = 0;
      let hasFreeDelivery = false;
      if (typeof products !== 'undefined' && products && products.length > 0) {
        products.forEach(p => {
          calcSubtotal += (p.price * (p.cartItem ? p.cartItem.quantity : 1));
          if (p.isFreeDelivery) hasFreeDelivery = true;
        });
      }
      const baseDelFee = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.delivery_inside) ? siteSettings.delivery_inside : 60;
      const calcDelFee = hasFreeDelivery ? 0 : baseDelFee;
      const calcGrandTotal = calcSubtotal + calcDelFee;
    %>
    <main class="checkout-section-wrapper">

        <div class="checkout-grid-row">

            <!-- Left Column: Customer Shipping & Order Form -->
            <div class="card-checkout-box">
                <div class="card-header-notice">
                    <h6>
                        To confirm your order, fill out the form and click <span style="color:#fe5200; font-weight:700;">"Place Order"</span> or order via phone call at 
                        <a href="tel:<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.phone) ? siteSettings.phone : '01700000000' %>" style="color:#fe5200; font-weight:800; text-decoration:none; font-size: 0.92rem;">📞 <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.phone) ? siteSettings.phone : '01700000000' %></a>.
                    </h6>
                </div>

                <div class="card-body-content">
                    <form action="/create-order" method="POST" id="checkout-main-form">

                        <div class="form-group-mb">
                            <label class="form-label-txt">Full Name <span style="color:#ef4444;">*</span></label>
                            <input type="text" name="name" id="cust-name" autocomplete="name" autofocus class="form-ctrl-input" placeholder="Enter your full name" required>
                        </div>

                        <div class="form-group-mb">
                            <label class="form-label-txt">Phone Number <span style="color:#ef4444;">*</span></label>
                            <input type="tel" name="phone" id="cust-phone" autocomplete="tel" minlength="11" maxlength="11" class="form-ctrl-input" placeholder="Enter 11-digit mobile number" required>
                        </div>

                        <div class="form-group-mb">
                            <label class="form-label-txt">Delivery Address <span style="color:#ef4444;">*</span> (District, Thana, House No)</label>
                            <input type="text" name="address" id="cust-address" autocomplete="street-address" class="form-ctrl-input" placeholder="Enter full delivery address" required>
                        </div>

                        <div class="form-group-mb">
                            <label class="form-label-txt">Select Delivery Area <span style="color:#ef4444;">*</span></label>
                            <% const delInside = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.delivery_inside) ? siteSettings.delivery_inside : 60; %>
                            <% const delOutside = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.delivery_outside) ? siteSettings.delivery_outside : 120; %>
                            <select name="area" id="delivery-area-select" class="form-ctrl-input" onchange="recalculateCartSummary()" required>
                                <option value="<%= delInside %>" selected>Inside Dhaka (৳ <%= delInside %>)</option>
                                <option value="<%= delOutside %>">Outside Dhaka (৳ <%= delOutside %>)</option>
                            </select>
                        </div>

                        <!-- Payment Method Selector -->
                        <div class="form-group-mb" style="margin-top: 1.5rem;">
                            <span class="payment-method-heading">Select Payment Method</span>
                            
                            <div class="payment-btn-tiles-grid">
                                <label class="payment-tile-card active">
                                    <input type="radio" name="payment_method" value="Cash On Delivery" checked style="display:none;">
                                    <i class="fa-solid fa-truck-fast" style="font-size: 1.25rem;"></i>
                                    <span>Cash On Delivery</span>
                                </label>
                                <% if (typeof bkashConfig !== 'undefined' && bkashConfig && bkashConfig.status) { %>
                                <label class="payment-tile-card">
                                    <input type="radio" name="payment_method" value="bkash" style="display:none;">
                                    <% if (bkashConfig.logo) { %>
                                        <img src="<%= bkashConfig.logo %>" alt="bKash" style="max-height: 46px; height: 42px; width: auto; max-width: 92%; object-fit: contain; display: block; margin: 0 auto;">
                                    <% } else { %>
                                        <i class="fa-solid fa-mobile-screen-button" style="font-size: 1.25rem;"></i>
                                        <span>bKash</span>
                                    <% } %>
                                </label>
                                <% } %>
                                <% if (typeof shurjopayConfig !== 'undefined' && shurjopayConfig && shurjopayConfig.status) { %>
                                <label class="payment-tile-card">
                                    <input type="radio" name="payment_method" value="shurjopay" style="display:none;">
                                    <% if (shurjopayConfig.logo) { %>
                                        <img src="<%= shurjopayConfig.logo %>" alt="Shurjopay" style="max-height: 46px; height: 42px; width: auto; max-width: 92%; object-fit: contain; display: block; margin: 0 auto;">
                                    <% } else { %>
                                        <i class="fa-regular fa-credit-card" style="font-size: 1.25rem;"></i>
                                        <span>Shurjopay</span>
                                    <% } %>
                                </label>
                                <% } %>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit-order-big desktop-place-order-btn">
                            Place Order <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Right Column: Order Details Summary -->
            <div class="card-checkout-box">
                <div class="card-header-title">
                    <h5>Order Details</h5>
                </div>

                <div class="card-body-content" style="padding: 0;">
                    <% if (products.length > 0) { %>
                        <% let subtotal = 0; %>
                        <div class="cart-table-responsive">
                            <table class="cart-summary-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th style="white-space: nowrap;">Price</th>
                                        <th style="text-align: center;">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% products.forEach(p => { %>
                                        <% const itemTotal = p.price * p.cartItem.quantity; %>
                                        <% subtotal += itemTotal; %>
                                        <tr id="cart-row-<%= p.id %>" data-unit-price="<%= p.price %>" data-free-delivery="<%= p.isFreeDelivery ? 'true' : 'false' %>">
                                            <td>
                                                <div class="cart-prod-flex">
                                                    <img src="<%= p.imageUrl %>" alt="<%= p.title %>" class="cart-prod-img">
                                                    <strong style="font-size: 0.88rem; color: #0f172a;"><%= p.title %> <% if (p.isFreeDelivery) { %><span style="background:#d1fae5; color:#047857; font-size:0.7rem; padding:2px 6px; border-radius:4px; margin-left:4px; font-weight:800; display:inline-block;">FREE DELIVERY</span><% } %></strong>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="qty-counter-sm">
                                                    <button type="button" class="qty-btn-btn" onclick="changeQty('<%= p.id %>', -1)">-</button>
                                                    <input type="text" id="qty-input-<%= p.id %>" value="<%= p.cartItem.quantity %>" readonly class="qty-val-txt">
                                                    <button type="button" class="qty-btn-btn" onclick="changeQty('<%= p.id %>', 1)">+</button>
                                                </div>
                                            </td>
                                            <td style="white-space: nowrap;"><strong style="color: #fe5200; white-space: nowrap; display: inline-flex; align-items: center; gap: 3px;">৳ <span id="item-total-<%= p.id %>"><%= itemTotal %></span></strong></td>
                                            <td>
                                                <form action="/cart-delete-item" method="POST" style="margin:0;">
                                                    <input type="hidden" value="<%= p.id %>" name="productId">
                                                    <button type="submit" class="btn-remove-item" title="Remove Item">✕</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <div style="padding: 1.25rem;">
                            <div class="summary-calc-row">
                                <span>Subtotal:</span>
                                <strong style="white-space: nowrap; display: inline-flex; align-items: center; gap: 3px;">৳ <span id="cart-subtotal-val"><%= subtotal %></span></strong>
                            </div>
                            <div class="summary-calc-row">
                                <span>Delivery Fee:</span>
                                <strong style="color: #0284c7; white-space: nowrap; display: inline-flex; align-items: center; gap: 3px;"><span id="cart-shipping-val"><%= calcDelFee === 0 ? 'FREE (৳ 0)' : ('৳ ' + calcDelFee) %></span></strong>
                            </div>
                            <div class="summary-calc-row summary-calc-total">
                                <span>Grand Total:</span>
                                <strong style="white-space: nowrap; display: inline-flex; align-items: center; gap: 3px;">৳ <span id="cart-grandtotal-val"><%= calcGrandTotal %></span></strong>
                            </div>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 4rem 1rem;">
                            <div style="font-size: 3rem; margin-bottom: 1rem;">🛒</div>
                            <h3>Your Cart is Empty!</h3>
                            <p style="color: #64748b; margin-top: 0.5rem; margin-bottom: 1.5rem;">Visit the shop page to buy your favorite products.</p>
                            <a href="/" style="background: #fe5200; color: white; text-decoration: none; padding: 0.75rem 1.75rem; border-radius: 10px; font-weight: 800; display: inline-block;">Return to Home</a>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>

    </main>

    <% if (products.length > 0) { %>
    <!-- Premium Mobile Sticky Bottom Bar (100% Exact Match to Product Detail Page) -->
    <div class="mobile-sticky-bar">
        <div class="sticky-info-col">
            <span class="sticky-price-label">Price</span>
            <span class="sticky-price-val">৳ <span id="mobile-sticky-grandtotal"><%= calcGrandTotal %></span></span>
        </div>
        <button type="submit" form="checkout-main-form" class="sticky-order-btn">
            <i class="fa-solid fa-bolt"></i> Order Now
        </button>
    </div>
    <% } %>

    <script>
        function recalculateCartSummary() {
            let totalSubtotal = 0;
            let hasFreeDelivery = false;
            const rows = document.querySelectorAll('tr[id^="cart-row-"]');
            
            rows.forEach(row => {
                const pId = row.id.replace('cart-row-', '');
                const unitPrice = parseFloat(row.getAttribute('data-unit-price')) || 0;
                const isFree = row.getAttribute('data-free-delivery') === 'true';
                if (isFree) hasFreeDelivery = true;

                const qtyInput = document.getElementById('qty-input-' + pId);
                const qty = parseInt(qtyInput.value) || 1;
                const itemTotal = unitPrice * qty;

                document.getElementById('item-total-' + pId).innerText = itemTotal;
                totalSubtotal += itemTotal;
            });

            const shippingSelect = document.getElementById('delivery-area-select');
            const baseShipping = parseInt(shippingSelect ? shippingSelect.value : 60) || 60;
            const shippingVal = hasFreeDelivery ? 0 : baseShipping;
            const grandTotal = totalSubtotal + shippingVal;

            if (document.getElementById('cart-subtotal-val')) document.getElementById('cart-subtotal-val').innerText = totalSubtotal;
            if (document.getElementById('cart-shipping-val')) document.getElementById('cart-shipping-val').innerText = hasFreeDelivery ? 'FREE (৳ 0)' : ('৳ ' + shippingVal);
            if (document.getElementById('cart-grandtotal-val')) document.getElementById('cart-grandtotal-val').innerText = grandTotal;
            if (document.getElementById('mobile-sticky-grandtotal')) document.getElementById('mobile-sticky-grandtotal').innerText = grandTotal;
        }

        function changeQty(productId, delta) {
            const input = document.getElementById('qty-input-' + productId);
            if (!input) return;

            let currentQty = parseInt(input.value) || 1;
            let newQty = currentQty + delta;
            if (newQty < 1) newQty = 1;

            input.value = newQty;
            recalculateCartSummary();

            // Send AJAX sync to update backend Sequelized cartItem table
            fetch('/cart-update-qty', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: newQty
                })
            })
            .then(res => res.json())
            .then(data => {
                console.log('Cart qty synced successfully:', data);
            })
            .catch(err => console.error('Error syncing cart qty:', err));
        }

        // Tile radio button selector interactivity
        document.querySelectorAll('.payment-tile-card').forEach(tile => {
            tile.addEventListener('click', function() {
                document.querySelectorAll('.payment-tile-card').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const radio = this.querySelector('input[type="radio"]');
                if (radio) radio.checked = true;
            });
        });

        // Smart LocalStorage Customer Info Auto-Fill for returning clients
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('checkout-main-form');
            const nameInput = document.getElementById('cust-name');
            const phoneInput = document.getElementById('cust-phone');
            const addressInput = document.getElementById('cust-address');

            // 1. Auto-fill saved info on load
            try {
                const saved = localStorage.getItem('rosedrape_customer_info');
                if (saved) {
                    const data = JSON.parse(saved);
                    if (data.name && nameInput && !nameInput.value) nameInput.value = data.name;
                    if (data.phone && phoneInput && !phoneInput.value) phoneInput.value = data.phone;
                    if (data.address && addressInput && !addressInput.value) addressInput.value = data.address;
                }
            } catch(e) {}

            // 2. Save info when submitting order
            if (form) {
                form.addEventListener('submit', function() {
                    try {
                        const info = {
                            name: nameInput ? nameInput.value.trim() : '',
                            phone: phoneInput ? phoneInput.value.trim() : '',
                            address: addressInput ? addressInput.value.trim() : ''
                        };
                        localStorage.setItem('rosedrape_customer_info', JSON.stringify(info));
                    } catch(e) {}
                });
            }
        });
    </script>

    <%- include('../includes/end.ejs') %>