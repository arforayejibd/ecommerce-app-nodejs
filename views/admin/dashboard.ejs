<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.name) ? siteSettings.name : 'One Commerce' %> Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    
    <style>
        body {
            background-color: #f1f5f9 !important;
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
            color: #0f172a;
        }

        .dashboard-page-container {
            max-width: 1380px;
            margin: 0 auto 3rem;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-top: 1.25rem;
            margin-bottom: 1.75rem;
        }

        /* Responsive Layout Overrides */
        @media (max-width: 1200px) {
            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .dash-row-charts, .dash-row-tables {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 991px) {
            .content-page {
                margin-top: 85px !important;
                padding: 0.85rem !important;
            }
            .dashboard-page-container {
                margin-bottom: 1.5rem;
            }
            .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.75rem;
                margin-top: 0.75rem;
                margin-bottom: 1.25rem;
            }
            .metric-card {
                padding: 0.85rem 1rem;
                border-radius: 14px;
            }
            .metric-icon-box {
                width: 38px;
                height: 38px;
                font-size: 1.1rem;
            }
            .metric-info h3 {
                font-size: 1.2rem;
            }
            .metric-info p {
                font-size: 0.68rem;
            }
            .metric-badge-pill {
                font-size: 0.65rem;
                padding: 0.15rem 0.45rem;
            }
            .dash-card {
                padding: 1rem;
                border-radius: 16px;
            }
            .dash-row-charts, .dash-row-tables {
                gap: 1.25rem;
                margin-bottom: 1.25rem;
            }
        }

        @media (max-width: 576px) {
            .metrics-grid {
                grid-template-columns: 1fr;
            }
            .metric-card {
                padding: 1rem 1.1rem;
            }
            .dash-card-header {
                flex-wrap: wrap;
                gap: 0.6rem;
            }
            .btn-view-all-pill {
                padding: 0.35rem 0.85rem;
                font-size: 0.78rem;
            }
            .fulfillment-ring {
                width: 120px;
                height: 120px;
            }
            .fulfillment-inner {
                width: 96px;
                height: 96px;
            }
            .fulfillment-val {
                font-size: 1.25rem;
            }
        }

        .metric-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.25rem 1.4rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
        }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
            border-color: #cbd5e1;
        }

        .metric-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .metric-icon-box {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .metric-info h3 {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 900;
            color: #0f172a;
            line-height: 1.2;
        }

        .metric-info p {
            margin: 0.2rem 0 0;
            font-size: 0.76rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .metric-badge-pill {
            font-size: 0.72rem;
            font-weight: 800;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            white-space: nowrap;
        }

        .badge-green { background: #d1fae5; color: #059669; }
        .badge-blue { background: #e0e7ff; color: #4f46e5; }
        .badge-amber { background: #fef3c7; color: #d97706; }
        .badge-cyan { background: #cff4fc; color: #0891b2; }

        /* Card Section General Styling */
        .dash-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            padding: 1.5rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            min-width: 0;
            max-width: 100%;
            overflow: hidden;
        }

        .dash-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .dash-card-title-box {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .icon-circle-box {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .dash-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .dash-subtitle {
            margin: 0.2rem 0 0;
            font-size: 0.82rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .btn-view-all-pill {
            background: #e0e7ff;
            color: #4f46e5;
            padding: 0.45rem 1.1rem;
            border-radius: 25px;
            font-size: 0.82rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
        }

        .btn-view-all-pill:hover {
            background: #4f46e5;
            color: #ffffff;
        }

        /* Layout Grids */
        .dash-row-charts {
            display: grid;
            grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
            gap: 1.5rem;
            margin-bottom: 1.75rem;
        }

        .dash-row-tables {
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 1.5rem;
        }

        @media (max-width: 1100px) {
            .dash-row-charts, .dash-row-tables {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        /* Table Scroll Container Fix */
        .dash-table-wrapper {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* Delivery Efficiency Circle */
        .fulfillment-circle-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 0;
            flex-grow: 1;
        }

        .fulfillment-ring {
            position: relative;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: conic-gradient(#4f46e5 0%, #e2e8f0 0%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fulfillment-inner {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .fulfillment-label {
            font-size: 0.76rem;
            color: #64748b;
            font-weight: 700;
        }

        .fulfillment-val {
            font-size: 1.45rem;
            font-weight: 900;
            color: #475569;
            margin-top: 2px;
        }

        .efficiency-footer {
            border-top: 1px solid #f1f5f9;
            padding-top: 1rem;
            margin-top: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            text-align: center;
        }

        .efficiency-stat-val {
            font-size: 1.25rem;
            font-weight: 900;
            color: #0f172a;
            margin-bottom: 0.15rem;
        }

        .efficiency-stat-lbl {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 600;
        }

        /* Clean Table Styling */
        .dash-table {
            width: 100%;
            min-width: 540px;
            border-collapse: collapse;
        }

        .dash-table th {
            background: #ffffff;
            padding: 0.85rem 0.75rem;
            font-size: 0.76rem;
            font-weight: 800;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #f1f5f9;
            text-align: left;
        }

        .dash-table td {
            padding: 0.85rem 0.75rem;
            border-bottom: 1px solid #f8fafc;
            font-size: 0.88rem;
            vertical-align: middle;
        }

        .dash-table tr:hover {
            background: #f8fafc;
        }

        .prod-thumb-sm {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
            background: #f1f5f9;
        }

        .status-pill {
            padding: 0.3rem 0.85rem;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .status-pill.st-pending {
            background: #f1f5f9;
            color: #64748b;
        }

        .status-pill.st-active {
            background: #d1fae5;
            color: #059669;
        }

        .action-eye-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #e0e7ff;
            color: #4f46e5;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .action-eye-btn:hover {
            background: #4f46e5;
            color: #ffffff;
        }

        .avatar-initials {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #e0e7ff;
            color: #4f46e5;
            font-weight: 800;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
</head>
<body class="admin-body">

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="content-page">
        <div class="dashboard-page-container">
            
            <!-- SECTION 1: Performance Metric Cards Grid -->
            <div class="metrics-grid">
                <!-- 1. Total Orders -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(254, 82, 0, 0.12); color: #fe5200;">
                            <i class="fe-shopping-bag"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof totalOrders !== 'undefined' ? totalOrders : 0 %></h3>
                            <p>Total Orders</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-green">+12.5%</span>
                </div>

                <!-- 2. Today's Orders -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(14, 165, 233, 0.12); color: #0ea5e9;">
                            <i class="fe-calendar"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof todayOrders !== 'undefined' ? todayOrders : 0 %></h3>
                            <p>Today's Orders</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-green">+8.2%</span>
                </div>

                <!-- 3. Products -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(6, 182, 212, 0.12); color: #06b6d4;">
                            <i class="fe-box"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof productsCount !== 'undefined' ? productsCount : 0 %></h3>
                            <p>Products</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-blue">Active</span>
                </div>

                <!-- 4. Total Customers -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                            <i class="fe-users"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof uniqueCustomers !== 'undefined' ? uniqueCustomers : 0 %></h3>
                            <p>Total Customers</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-green">+5.1%</span>
                </div>

                <!-- 5. Today's Deliveries -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                            <i class="fe-truck"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof todayDelivered !== 'undefined' ? todayDelivered : 0 %></h3>
                            <p>Today's Deliveries</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-amber">Today</span>
                </div>

                <!-- 6. Completed Deliveries -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(139, 92, 246, 0.12); color: #8b5cf6;">
                            <i class="fe-check-circle"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof completedCount !== 'undefined' ? completedCount : 0 %></h3>
                            <p>Completed Deliveries</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-green">Complete</span>
                </div>

                <!-- 7. Weekly Deliveries -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(99, 102, 241, 0.12); color: #6366f1;">
                            <i class="fe-clock"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof weeklyDeliveries !== 'undefined' ? weeklyDeliveries : 0 %></h3>
                            <p>Weekly Deliveries</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-cyan">This Week</span>
                </div>

                <!-- 8. Monthly Deliveries -->
                <div class="metric-card">
                    <div class="metric-left">
                        <div class="metric-icon-box" style="background: rgba(236, 72, 153, 0.12); color: #ec4899;">
                            <i class="fe-calendar"></i>
                        </div>
                        <div class="metric-info">
                            <h3><%= typeof monthlyDeliveries !== 'undefined' ? monthlyDeliveries : 0 %></h3>
                            <p>Monthly Deliveries</p>
                        </div>
                    </div>
                    <span class="metric-badge-pill badge-blue">Last Month</span>
                </div>
            </div>

            <!-- SECTION 2: Analytics Row (Sales Overview Chart & Delivery Efficiency) -->
            <div class="dash-row-charts">
                <!-- Sales & Revenue Overview -->
                <div class="dash-card">
                    <div class="dash-card-header">
                        <div>
                            <h4 class="dash-title">Sales & Revenue Overview</h4>
                            <p class="dash-subtitle">Daily sales history for completed orders</p>
                        </div>
                        <div>
                            <button type="button" style="background:none; border:none; color:#94a3b8; font-size:1.2rem; cursor:pointer;">
                                <i class="fe-more-vertical"></i>
                            </button>
                        </div>
                    </div>
                    <div style="flex-grow: 1; position: relative; min-height: 220px;">
                        <canvas id="salesRevenueChart"></canvas>
                    </div>
                </div>

                <!-- Delivery Efficiency -->
                <% const fRate = typeof fulfillmentRate !== 'undefined' ? fulfillmentRate : 0; %>
                <% const tDelivered = typeof todayDelivered !== 'undefined' ? todayDelivered : 0; %>
                <% const cCount = typeof completedCount !== 'undefined' ? completedCount : 0; %>

                <div class="dash-card">
                    <div class="dash-card-header">
                        <div>
                            <h4 class="dash-title">Delivery Efficiency</h4>
                            <p class="dash-subtitle">Order delivery fulfillment rate</p>
                        </div>
                    </div>

                    <div class="fulfillment-circle-wrapper">
                        <div class="fulfillment-ring" style="background: conic-gradient(#4f46e5 <%= fRate %>%, #e2e8f0 0%);">
                            <div class="fulfillment-inner">
                                <span class="fulfillment-label">Fulfillment</span>
                                <span class="fulfillment-val"><%= fRate %>%</span>
                            </div>
                        </div>
                    </div>

                    <div class="efficiency-footer">
                        <div>
                            <div class="efficiency-stat-val"><%= tDelivered %></div>
                            <div class="efficiency-stat-lbl">Today's Delivered</div>
                        </div>
                        <div>
                            <div class="efficiency-stat-val"><%= cCount %></div>
                            <div class="efficiency-stat-lbl">Total Delivered</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: Data Tables Row (Latest Orders & New Customers) -->
            <div class="dash-row-tables">
                <!-- Latest Orders -->
                <div class="dash-card">
                    <div class="dash-card-header">
                        <div class="dash-card-title-box">
                            <div class="icon-circle-box" style="background: #e0e7ff; color: #4f46e5;">
                                <i class="fe-shopping-bag"></i>
                            </div>
                            <div>
                                <h4 class="dash-title">Latest Orders</h4>
                                <p class="dash-subtitle">Most recent customer orders</p>
                            </div>
                        </div>
                        <a href="/admin/orders" class="btn-view-all-pill">
                            View All <i class="fe-arrow-right font-12"></i>
                        </a>
                    </div>

                    <div class="dash-table-wrapper">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 12%;">PRODUCT</th>
                                    <th style="width: 18%;">INVOICE</th>
                                    <th style="width: 25%;">CUSTOMER</th>
                                    <th style="width: 18%;">AMOUNT</th>
                                    <th style="width: 15%;">STATUS</th>
                                    <th style="width: 7%; text-align: center;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentOrders !== 'undefined' && recentOrders && recentOrders.length > 0) { %>
                                    <% recentOrders.forEach((order, index) => { %>
                                        <%
                                            let pImg = '/backEnd/assets/images/products/product-1.jpg';
                                            if (order.products && order.products.length > 0 && order.products[0].imageUrl) {
                                                pImg = order.products[0].imageUrl;
                                            }

                                            let orderTotal = 0;
                                            if (order.products && order.products.length > 0) {
                                                orderTotal = order.products.reduce((acc, p) => acc + (p.price * (p.orderItem ? p.orderItem.quantity : 1)), 0) + (parseInt(order.area) || 60) - (order.discount || 0);
                                            } else {
                                                orderTotal = order.amount || 750;
                                            }
                                        %>
                                        <tr>
                                            <td><strong><%= index + 1 %></strong></td>
                                            <td>
                                                <img src="<%= pImg %>" alt="Product" class="prod-thumb-sm" onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'40\' height=\'40\' fill=\'%23f1f5f9\'><rect width=\'100%\' height=\'100%\' fill=\'%23f1f5f9\'/></svg>';">
                                            </td>
                                            <td>
                                                <a href="/admin/order/edit/<%= order.id %>" style="color: #4f46e5; font-weight: 800; text-decoration: none;">
                                                    <%= order.invoiceId || ('#000' + order.id) %>
                                                </a>
                                            </td>
                                            <td>
                                                <span style="font-weight: 600; color: #334155;"><%= order.name || 'Customer' %></span>
                                            </td>
                                            <td>
                                                <strong style="color: #10b981; font-weight: 800;">৳<%= orderTotal.toFixed(2) %></strong>
                                            </td>
                                            <td>
                                                <span class="status-pill st-pending">
                                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #94a3b8;"></span>
                                                    <%= order.status || 'Pending' %>
                                                </span>
                                            </td>
                                            <td style="text-align: center;">
                                                <a href="/admin/order/edit/<%= order.id %>" class="action-eye-btn" title="View Order">
                                                    <i class="fe-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" style="text-align: center; color: #94a3b8; padding: 2rem 0;">
                                            No recent orders found
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- New Customers -->
                <div class="dash-card">
                    <div class="dash-card-header">
                        <div class="dash-card-title-box">
                            <div class="icon-circle-box" style="background: #d1fae5; color: #059669;">
                                <i class="fe-users"></i>
                            </div>
                            <div>
                                <h4 class="dash-title">New Customers</h4>
                                <p class="dash-subtitle">Recently registered</p>
                            </div>
                        </div>
                        <a href="/admin/customer" class="btn-view-all-pill">
                            View All <i class="fe-arrow-right font-12"></i>
                        </a>
                    </div>

                    <div class="dash-table-wrapper">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%;">#</th>
                                    <th style="width: 32%;">NAME</th>
                                    <th style="width: 30%;">PHONE</th>
                                    <th style="width: 20%;">JOINED</th>
                                    <th style="width: 10%;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentUsers !== 'undefined' && recentUsers && recentUsers.length > 0) { %>
                                    <% recentUsers.forEach((u, index) => { %>
                                        <%
                                            const initials = u.name ? u.name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() : 'CU';
                                        %>
                                        <tr>
                                            <td><strong><%= index + 1 %></strong></td>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                                    <div class="avatar-initials"><%= initials %></div>
                                                    <span style="font-weight: 700; color: #0f172a;"><%= u.name || 'Demo Customer' %></span>
                                                </div>
                                            </td>
                                            <td>
                                                <span style="color: #64748b; font-size: 0.85rem; font-weight: 600;">
                                                    <i class="fe-phone me-1 font-11"></i><%= u.email ? u.email.split('@')[0] : (u.phone || '01700000000') %>
                                                </span>
                                            </td>
                                            <td>
                                                <span style="color: #64748b; font-size: 0.82rem; font-weight: 600;">
                                                    <%= new Date(u.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="status-pill st-active">
                                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981;"></span>
                                                    Active
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center; color: #94a3b8; padding: 2rem 0;">
                                            No recent customers found
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.feather) {
                feather.replace();
            }

            // Render Sales & Revenue Chart
            const ctx = document.getElementById('salesRevenueChart');
            if (ctx) {
                const labels = <%- typeof chartLabels !== 'undefined' ? chartLabels : '[]' %>;
                const data = <%- typeof chartData !== 'undefined' ? chartData : '[]' %>;

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Revenue (৳)',
                            data: data,
                            borderColor: '#818cf8',
                            backgroundColor: 'rgba(129, 140, 248, 0.08)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#6366f1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Revenue: ৳' + context.parsed.y.toLocaleString();
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: '#94a3b8', font: { family: 'Inter', size: 11 } }
                            },
                            y: {
                                grid: { color: '#f1f5f9' },
                                ticks: { color: '#94a3b8', font: { family: 'Inter', size: 11 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
