<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>General Setting Manage - <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.name) ? siteSettings.name : 'One Commerce' %> Admin</title>
    <!-- Icons & Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">

    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Inter', sans-serif;
            color: #0f172a;
            margin: 0; padding: 0;
        }

        [data-theme="dark"] body {
            background-color: #0f172a !important;
            color: #f8fafc !important;
        }

        /* Prevent header text from getting hidden under fixed navbar */
        .content-page {
            margin-top: 85px !important;
            padding: 1.5rem !important;
        }

        .settings-page-container {
            max-width: 1280px;
            margin: 0 auto 5rem;
        }

        /* ── WHITE HERO BANNER CARD ── */
        .settings-hero-card {
            background: #ffffff !important;
            border-radius: 20px;
            padding: 1.85rem 2.25rem;
            color: #0f172a !important;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1.25rem;
        }

        [data-theme="dark"] .settings-hero-card {
            background: #1e293b !important;
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .settings-hero-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            margin: 0 0 0.4rem 0;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            color: #0f172a !important;
        }

        [data-theme="dark"] .settings-hero-title {
            color: #f8fafc !important;
        }

        .settings-hero-subtitle {
            font-size: 0.925rem;
            color: #64748b !important;
            margin: 0;
            font-weight: 500;
        }

        [data-theme="dark"] .settings-hero-subtitle {
            color: #94a3b8 !important;
        }

        /* Top Save Action Button */
        .btn-save-settings-top {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff !important;
            border: none;
            padding: 0.75rem 1.6rem;
            font-size: 0.925rem;
            font-weight: 800;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-save-settings-top:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.45);
        }

        .btn-compress-action {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            color: #475569;
            padding: 0.75rem 1.3rem;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        [data-theme="dark"] .btn-compress-action {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.12);
            color: #cbd5e1;
        }

        .btn-compress-action:hover {
            background: #e2e8f0;
            color: #0f172a;
            transform: translateY(-2px);
        }

        /* ── 2-COLUMN MAIN GRID ── */
        .settings-main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.75rem;
            align-items: start;
        }

        @media (max-width: 1024px) {
            .settings-main-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ── CARD SECTIONS ── */
        .settings-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 2rem 2.25rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 1.75rem;
            transition: all 0.25s ease;
        }

        .settings-card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
            border-color: #cbd5e1;
        }

        [data-theme="dark"] .settings-card {
            background: #1e293b;
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        [data-theme="dark"] .settings-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
        }

        .card-section-title {
            font-size: 1.15rem;
            font-weight: 800;
            font-family: 'Outfit', sans-serif;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #0f172a;
            padding-bottom: 0.85rem;
            border-bottom: 1px solid #f1f5f9;
        }

        [data-theme="dark"] .card-section-title {
            color: #f8fafc;
            border-bottom-color: rgba(255, 255, 255, 0.08);
        }

        .title-left-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .card-icon-circle {
            width: 38px; height: 38px; border-radius: 12px;
            background: rgba(99, 102, 241, 0.12); color: #6366f1;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }

        .card-badge {
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.25rem 0.65rem;
            border-radius: 20px;
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }

        /* ── GRID HELPERS ── */
        .form-grid-2 {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;
        }

        @media (max-width: 640px) {
            .form-grid-2 { grid-template-columns: 1fr; }
        }

        /* ── FORM CONTROL STYLING ── */
        .form-group { margin-bottom: 1.35rem; }

        .form-label {
            display: block; font-weight: 700; font-size: 0.88rem;
            color: #334155; margin-bottom: 0.5rem;
        }

        [data-theme="dark"] .form-label { color: #cbd5e1; }

        .form-control {
            width: 100%; padding: 0.8rem 1rem; background: #f8fafc;
            border: 1.5px solid #e2e8f0; border-radius: 12px;
            font-size: 0.925rem; font-family: inherit; color: #0f172a;
            outline: none; transition: all 0.25s ease; box-sizing: border-box;
        }

        [data-theme="dark"] .form-control {
            background: rgba(15, 23, 42, 0.6);
            border-color: rgba(255, 255, 255, 0.1); color: #f8fafc;
        }

        .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
            background: #ffffff;
        }

        textarea.form-control { min-height: 110px; resize: vertical; }

        /* ── MEDIA ASSET BOX ── */
        .media-asset-box {
            background: #ffffff; border-radius: 14px; border: 1.5px solid #e2e8f0;
            padding: 0.85rem; display: flex; flex-direction: column; gap: 0.65rem;
            transition: all 0.2s ease;
        }

        [data-theme="dark"] .media-asset-box {
            background: rgba(15, 23, 42, 0.5); border-color: rgba(255, 255, 255, 0.08);
        }

        .media-asset-preview {
            width: 100%; height: 95px; border-radius: 10px; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid #e2e8f0; position: relative;
        }

        .media-asset-preview img {
            max-width: 100%; max-height: 100%; object-fit: contain;
        }

        /* ── TOGGLE SWITCH ── */
        .switch-container {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0.85rem 1.25rem; background: #f8fafc; border-radius: 12px;
            border: 1.5px solid #e2e8f0;
        }

        [data-theme="dark"] .switch-container {
            background: rgba(15, 23, 42, 0.6); border-color: rgba(255, 255, 255, 0.1);
        }

        .switch-label { font-weight: 700; font-size: 0.9rem; color: #0f172a; }
        [data-theme="dark"] .switch-label { color: #f8fafc; }

        .switch { position: relative; display: inline-block; width: 48px; height: 26px; }
        .switch input { opacity: 0; width: 0; height: 0; }

        .slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #cbd5e1; transition: .3s; border-radius: 34px;
        }

        .slider:before {
            position: absolute; content: ""; height: 20px; width: 20px;
            left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%;
        }

        input:checked + .slider { background-color: #10b981; }
        input:checked + .slider:before { transform: translateX(22px); }

        /* ── STICKY FOOTER ACTION BAR ── */
        .sticky-save-bar {
            position: sticky; bottom: 1.5rem; z-index: 100;
            background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(12px);
            padding: 1rem 1.75rem; border-radius: 18px; border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            display: flex; align-items: center; justify-content: space-between;
            color: white; margin-top: 2rem;
        }

        .btn-save-settings {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: white; border: none; padding: 0.75rem 1.85rem; font-size: 0.95rem;
            font-weight: 800; border-radius: 12px; cursor: pointer; transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.35);
            display: inline-flex; align-items: center; gap: 0.5rem;
        }

        .btn-save-settings:hover {
            transform: translateY(-2px); box-shadow: 0 10px 25px rgba(79, 70, 229, 0.5);
        }

        /* Toast notification */
        .settings-toast {
            position: fixed; bottom: 2rem; right: 2rem;
            background: #10b981; color: white; padding: 1rem 1.5rem;
            border-radius: 14px; font-weight: 700; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.4);
            display: flex; align-items: center; gap: 0.6rem; z-index: 9999;
            opacity: 0; transform: translateY(20px); transition: all 0.3s ease; pointer-events: none;
        }

        .settings-toast.show { opacity: 1; transform: translateY(0); }
    </style>
</head>
<body>

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="content-page">
        <div class="settings-page-container">

            <!-- Hero Banner -->
            <div class="settings-hero-card">
                <div>
                    <h1 class="settings-hero-title">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        General Settings Manage
                    </h1>
                    <p class="settings-hero-subtitle">Manage store identity, branding logos, delivery charges, social channels & SEO meta information</p>
                </div>
                <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                    <button type="button" class="btn-compress-action" onclick="compressServerImages()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> Compress Images
                    </button>
                    <button type="submit" form="general-settings-form" class="btn-save-settings-top" id="top-submit-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save All Settings
                    </button>
                </div>
            </div>

            <!-- Form Start -->
            <% const s = typeof setting !== 'undefined' && setting ? setting : {}; %>
            <form id="general-settings-form" action="/admin/settings" method="POST" onsubmit="saveSettings(event)">

                <div class="settings-main-grid">

                    <!-- LEFT COLUMN -->
                    <div class="settings-grid-col">

                        <!-- SECTION 1: STORE IDENTITY -->
                        <div class="settings-card">
                            <div class="card-section-title">
                                <div class="title-left-group">
                                    <div class="card-icon-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                    </div>
                                    <span>Store Identity & System Status</span>
                                </div>
                                <span class="card-badge">Identity</span>
                            </div>

                            <div class="form-grid-2">
                                <div class="form-group">
                                    <label class="form-label">Store Name *</label>
                                    <input type="text" class="form-control" name="name" value="<%= s.name || 'One Commerce' %>" required>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Hotline Phone Number *</label>
                                    <input type="text" class="form-control" name="phone" value="<%= s.phone || '01700000000' %>" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Google Play Store App Link</label>
                                <input type="url" class="form-control" name="play_store" value="<%= s.play_store || 'https://play.google.com/store/apps/details?id=com.onecommercebd.app' %>" placeholder="https://play.google.com/...">
                            </div>

                            <div class="form-group">
                                <label class="form-label">Developer / System Copyright Name (Footer Credit)</label>
                                <input type="text" class="form-control" name="developer_name" value="<%= s.developer_name || 'OneHost BD' %>" placeholder="OneHost BD">
                            </div>

                            <div class="form-group">
                                <label class="form-label">System Language / সাইট ভাষা *</label>
                                <select class="form-control" name="language" style="font-weight: 700; cursor: pointer;">
                                    <option value="bn" <%= (s.language || 'bn') === 'bn' ? 'selected' : '' %>>🇧🇩 বাংলা (Bangla)</option>
                                    <option value="en" <%= s.language === 'en' ? 'selected' : '' %>>🇬🇧 English</option>
                                </select>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label">Site Active Status</label>
                                <div class="switch-container">
                                    <span class="switch-label">Storefront Online (Active / Maintenance)</span>
                                    <label class="switch">
                                        <input type="checkbox" name="status" value="1" <%= s.status !== false ? 'checked' : '' %>>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: BRAND LOGOS & ASSETS -->
                        <div class="settings-card">
                            <div class="card-section-title">
                                <div class="title-left-group">
                                    <div class="card-icon-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                    </div>
                                    <span>Brand Logos & Media Assets</span>
                                </div>
                                <span class="card-badge">Media</span>
                            </div>

                            <div class="form-grid-2">
                                <!-- White Logo -->
                                <div class="media-asset-box">
                                    <span class="form-label" style="margin: 0; font-size: 0.82rem;">White Logo (Dark Mode)</span>
                                    <input type="hidden" id="input_white_logo" name="white_logo" value="<%= s.white_logo || '' %>">
                                    <div class="media-asset-preview" style="background:#0f172a;">
                                        <img src="<%= s.white_logo || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'40\' fill=\'%23f8fafc\'><rect width=\'100%\' height=\'100%\' fill=\'%23f8fafc\'/></svg>' %>" id="preview_white_logo" alt="White Logo">
                                    </div>
                                    <button type="button" class="btn-add-new-product" onclick="openMediaPicker(u => { document.getElementById('input_white_logo').value = u; updatePreview('white_logo', u); })" style="border: none; width: 100%; justify-content: center; font-size: 0.82rem; padding: 0.55rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right:0.35rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Browse Logo
                                    </button>
                                </div>

                                <!-- Dark Logo -->
                                <div class="media-asset-box">
                                    <span class="form-label" style="margin: 0; font-size: 0.82rem;">Dark Logo (Light Mode)</span>
                                    <input type="hidden" id="input_dark_logo" name="dark_logo" value="<%= s.dark_logo || '' %>">
                                    <div class="media-asset-preview" style="background:#ffffff;">
                                        <img src="<%= s.dark_logo || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'40\' fill=\'%23f8fafc\'><rect width=\'100%\' height=\'100%\' fill=\'%23f8fafc\'/></svg>' %>" id="preview_dark_logo" alt="Dark Logo">
                                    </div>
                                    <button type="button" class="btn-add-new-product" onclick="openMediaPicker(u => { document.getElementById('input_dark_logo').value = u; updatePreview('dark_logo', u); })" style="border: none; width: 100%; justify-content: center; font-size: 0.82rem; padding: 0.55rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right:0.35rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Browse Logo
                                    </button>
                                </div>

                                <!-- Favicon -->
                                <div class="media-asset-box">
                                    <span class="form-label" style="margin: 0; font-size: 0.82rem;">Favicon (Tab Icon)</span>
                                    <input type="hidden" id="input_favicon" name="favicon" value="<%= s.favicon || '' %>">
                                    <div class="media-asset-preview" style="background:#f8fafc;">
                                        <img src="<%= s.favicon || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'32\' height=\'32\' fill=\'%23f8fafc\'><rect width=\'100%\' height=\'100%\' fill=\'%23f8fafc\'/></svg>' %>" id="preview_favicon" style="width:36px; height:36px;" alt="Favicon">
                                    </div>
                                    <button type="button" class="btn-add-new-product" onclick="openMediaPicker(u => { document.getElementById('input_favicon').value = u; updatePreview('favicon', u); })" style="border: none; width: 100%; justify-content: center; font-size: 0.82rem; padding: 0.55rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right:0.35rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Browse Favicon
                                    </button>
                                </div>

                                <!-- OG Banner -->
                                <div class="media-asset-box">
                                    <span class="form-label" style="margin: 0; font-size: 0.82rem;">OG Social Banner</span>
                                    <input type="hidden" id="input_og_baner" name="og_baner" value="<%= s.og_baner || '' %>">
                                    <div class="media-asset-preview" style="background:#f8fafc;">
                                        <img src="<%= s.og_baner || 'data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'40\' fill=\'%23f8fafc\'><rect width=\'100%\' height=\'100%\' fill=\'%23f8fafc\'/></svg>' %>" id="preview_og_baner" alt="OG Banner">
                                    </div>
                                    <button type="button" class="btn-add-new-product" onclick="openMediaPicker(u => { document.getElementById('input_og_baner').value = u; updatePreview('og_baner', u); })" style="border: none; width: 100%; justify-content: center; font-size: 0.82rem; padding: 0.55rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right:0.35rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Browse Banner
                                    </button>
                                </div>
                            </div>

                            <div style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid #f1f5f9;">
                                <div class="form-grid-2">
                                    <div class="form-group" style="margin: 0;">
                                        <label class="form-label">Primary Color</label>
                                        <input type="color" class="form-control" name="primary_color" value="<%= s.primary_color || '#6366f1' %>" style="height: 44px; padding: 4px 8px; cursor: pointer;">
                                    </div>

                                    <div class="form-group" style="margin: 0;">
                                        <label class="form-label">Secondary Color</label>
                                        <input type="color" class="form-control" name="secondary_color" value="<%= s.secondary_color || '#4f46e5' %>" style="height: 44px; padding: 4px 8px; cursor: pointer;">
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="settings-grid-col">

                        <!-- SECTION 3: SOCIAL LINKS & CONTACT -->
                        <div class="settings-card">
                            <div class="card-section-title">
                                <div class="title-left-group">
                                    <div class="card-icon-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    </div>
                                    <span>Social Channels & Address</span>
                                </div>
                                <span class="card-badge">Contact</span>
                            </div>

                            <div class="form-grid-2">
                                <div class="form-group">
                                    <label class="form-label">Facebook Page Link</label>
                                    <input type="url" class="form-control" name="facebook" value="<%= s.facebook || 'https://facebook.com/onecommercebd' %>" placeholder="https://facebook.com/...">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Instagram Profile Link</label>
                                    <input type="url" class="form-control" name="instagram" value="<%= s.instagram || 'https://instagram.com/onecommercebd' %>" placeholder="https://instagram.com/...">
                                </div>
                            </div>

                            <div class="form-grid-2">
                                <div class="form-group">
                                    <label class="form-label">YouTube Channel Link</label>
                                    <input type="url" class="form-control" name="youtube" value="<%= s.youtube || 'https://youtube.com/c/onecommercebd' %>" placeholder="https://youtube.com/...">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">TikTok Profile Link</label>
                                    <input type="url" class="form-control" name="tiktok" value="<%= s.tiktok || 'https://tiktok.com/@onecommercebd' %>" placeholder="https://tiktok.com/...">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Support Email Address</label>
                                <input type="email" class="form-control" name="email" value="<%= s.email || 'support@onecommercebd.com' %>" placeholder="support@domain.com">
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label">Physical Office / Store Address</label>
                                <input type="text" class="form-control" name="address" value="<%= s.address || 'House 12, Road 5, Block B, Mirpur, Dhaka 1216' %>" placeholder="Enter store address">
                            </div>
                        </div>

                        <!-- SECTION 4: SHIPPING & DELIVERY -->
                        <div class="settings-card">
                            <div class="card-section-title">
                                <div class="title-left-group">
                                    <div class="card-icon-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                    </div>
                                    <span>Shipping & Delivery Charges</span>
                                </div>
                                <span class="card-badge">Logistics</span>
                            </div>

                            <div class="form-grid-2">
                                <div class="form-group" style="margin: 0;">
                                    <label class="form-label">Delivery Inside Dhaka (৳) *</label>
                                    <input type="number" class="form-control" name="delivery_inside" value="<%= s.delivery_inside || 60 %>" required>
                                </div>

                                <div class="form-group" style="margin: 0;">
                                    <label class="form-label">Delivery Outside Dhaka (৳) *</label>
                                    <input type="number" class="form-control" name="delivery_outside" value="<%= s.delivery_outside || 120 %>" required>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 5: SEO & META -->
                        <div class="settings-card" style="margin-bottom: 0;">
                            <div class="card-section-title">
                                <div class="title-left-group">
                                    <div class="card-icon-circle">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                    </div>
                                    <span>Search Engine Optimization (SEO)</span>
                                </div>
                                <span class="card-badge">SEO</span>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Meta Description *</label>
                                <textarea class="form-control" name="meta_description" placeholder="Enter site meta description for SEO..." required><%= s.meta_description || 'One Commerce - Best online fashion and lifestyle store in Bangladesh offering quality products at affordable prices.' %></textarea>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label">Meta Keywords *</label>
                                <input type="text" class="form-control" name="meta_keyword" value="<%= s.meta_keyword || 'ecommerce, fashion, clothing, Bangladesh, online shopping, One Commerce' %>" required>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Sticky Bottom Action Bar -->
                <div class="sticky-save-bar">
                    <div style="font-size: 0.88rem; font-weight: 600; opacity: 0.9;">
                        Unsaved changes will be updated upon saving.
                    </div>
                    <button type="submit" class="btn-save-settings" id="bottom-submit-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save All Settings
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- Success Toast Notification -->
    <div class="settings-toast" id="settings-toast">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>General settings updated successfully!</span>
    </div>

    <script>
        function updatePreview(id, url) {
            const preview = document.getElementById('preview_' + id);
            if (preview && url) {
                preview.src = url;
            }
        }

        function saveSettings(e) {
            e.preventDefault();
            const form = e.target;
            const topBtn = document.getElementById('top-submit-btn');
            const bottomBtn = document.getElementById('bottom-submit-btn');
            const toast = document.getElementById('settings-toast');

            const savingHtml = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="animation: spin 1s linear infinite;"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg> Saving...';
            const normalHtml = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Save All Settings';

            if (topBtn) { topBtn.disabled = true; topBtn.innerHTML = savingHtml; }
            if (bottomBtn) { bottomBtn.disabled = true; bottomBtn.innerHTML = savingHtml; }

            fetch('/admin/settings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json'
                },
                body: new URLSearchParams(new FormData(form))
            })
            .then(res => res.json())
            .then(data => {
                if (topBtn) { topBtn.disabled = false; topBtn.innerHTML = normalHtml; }
                if (bottomBtn) { bottomBtn.disabled = false; bottomBtn.innerHTML = normalHtml; }
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3500);
            })
            .catch(err => {
                if (topBtn) { topBtn.disabled = false; topBtn.innerHTML = normalHtml; }
                if (bottomBtn) { bottomBtn.disabled = false; bottomBtn.innerHTML = normalHtml; }
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3500);
            });
        }

        function compressServerImages() {
            alert("Compressing & Optimizing Server Images...\n\nResult: 4.2 MB storage saved! All product & banner images optimized.");
        }
    </script>
    <style>
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</body>
</html>
