<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Order #INV-<%= order.id %> - Rosedrape Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
    <!-- Feather Icons & FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://unpkg.com/feather-icons"></script>
    
    <style>
        body {
            background-color: #f1f5f9 !important;
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
        }

        /* Layout Engine integration with topbar & sidebar */
        .content-page {
            margin-left: 260px;
            margin-top: 75px;
            padding: 1.5rem;
            min-height: calc(100vh - 75px);
            width: calc(100% - 260px);
            box-sizing: border-box;
        }

        @media (max-width: 991px) {
            .content-page {
                margin-left: 0 !important;
                width: 100% !important;
                margin-top: 75px !important;
                padding: 1rem;
            }
        }

        .edit-order-container {
            max-width: 1280px;
            margin: 0 auto 3rem;
        }

        /* Top Header Bar */
        .page-header-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.25rem 1.75rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .header-title-box {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .order-inv-badge {
            background: linear-gradient(135deg, #fe5200 0%, #eb3b5a 100%);
            color: #ffffff;
            padding: 0.35rem 0.85rem;
            border-radius: 8px;
            font-weight: 900;
            font-size: 1.1rem;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 12px rgba(254, 82, 0, 0.25);
        }

        .header-meta {
            font-size: 0.82rem;
            color: #64748b;
            margin-top: 0.2rem;
        }

        .btn-back-link {
            background: #f1f5f9;
            color: #334155;
            padding: 0.6rem 1.25rem;
            border-radius: 30px;
            font-size: 0.88rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border: 1px solid #cbd5e1;
            transition: all 0.2s ease;
        }

        .btn-back-link:hover {
            background: #e2e8f0;
            color: #0f172a;
            transform: translateX(-2px);
        }

        /* 2-Column Grid (Left: Form Controls 7fr, Right: Items Summary 5fr) */
        .edit-order-grid {
            display: grid;
            grid-template-columns: 6.8fr 5.2fr;
            gap: 1.5rem;
            align-items: start;
        }

        @media (max-width: 992px) {
            .edit-order-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Card Section Styling */
        .section-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .section-header {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem 1.25rem;
            font-size: 0.98rem;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .section-body {
            padding: 1.35rem;
        }

        /* Products Summary Table */
        .prod-summary-table {
            width: 100%;
            border-collapse: collapse;
        }

        .prod-summary-table th {
            background: #f8fafc;
            padding: 0.65rem 0.85rem;
            font-size: 0.78rem;
            font-weight: 800;
            color: #475569;
            text-transform: uppercase;
            border-bottom: 1px solid #e2e8f0;
        }

        .prod-summary-table td {
            padding: 0.85rem;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.88rem;
            vertical-align: middle;
        }

        .item-thumb {
            width: 44px;
            height: 44px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
        }

        .item-qty-input {
            width: 60px;
            padding: 4px 8px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            text-align: center;
            font-weight: 800;
            font-size: 0.88rem;
            outline: none;
        }

        .btn-remove-item {
            background: #fee2e2;
            color: #ef4444;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-remove-item:hover {
            background: #ef4444;
            color: #ffffff;
        }

        /* Financial Summary Box */
        .summary-line-item {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            margin-bottom: 0.5rem;
            color: #475569;
        }

        .summary-line-item.grand-total {
            font-size: 1.15rem;
            font-weight: 900;
            color: #fe5200;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 2px solid #e2e8f0;
        }

        /* Form Inputs & Controls */
        .form-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 800;
            color: #475569;
            text-transform: uppercase;
            margin-bottom: 0.45rem;
            letter-spacing: 0.4px;
        }

        .form-control-custom {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            color: #0f172a;
            font-size: 0.95rem;
            font-weight: 600;
            outline: none;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .form-control-custom:focus {
            border-color: #fe5200;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(254, 82, 0, 0.12);
        }

        .input-group-custom {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.95rem;
        }

        .input-group-custom .form-control-custom {
            padding-left: 2.6rem;
        }

        /* Add Product Box */
        .add-prod-box {
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            gap: 0.6rem;
            align-items: center;
        }

        .btn-add-product {
            background: #10b981;
            color: white;
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            border: none;
            font-weight: 800;
            font-size: 0.85rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            white-space: nowrap;
        }

        .btn-add-product:hover {
            background: #059669;
        }

        /* Submit Button */
        .btn-save-order {
            background: linear-gradient(135deg, #fe5200 0%, #eb3b5a 100%);
            color: white;
            padding: 0.95rem 2.5rem;
            border-radius: 30px;
            border: none;
            font-weight: 900;
            font-size: 1.05rem;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(254, 82, 0, 0.4);
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            transition: all 0.2s ease;
        }

        .btn-save-order:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(254, 82, 0, 0.5);
            color: white;
        }
    </style>
</head>
<body class="admin-body">

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="content-page">
        <!-- Main Form Wrapper -->
        <form action="/admin/order/edit" method="POST" id="edit-order-form">
            <input type="hidden" name="id" value="<%= order.id %>">
            
            <div class="edit-order-container">
                
                <!-- Header Title Bar -->
                <div class="page-header-card">
                    <div class="header-title-box">
                        <span class="order-inv-badge">#INV-<%= order.id %></span>
                        <div>
                            <h3 style="margin: 0; font-size: 1.3rem; font-weight: 900; color: #0f172a;">Edit Order Details</h3>
                            <div class="header-meta">
                                Placed on: <strong><%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong>
                                <span style="margin: 0 6px;">•</span>
                                Status: <span class="badge-tag" style="background: rgba(254, 82, 0, 0.15); color: #fe5200; font-weight: 800;"><%= order.status || 'Pending' %></span>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                        <button type="submit" class="btn-save-order" style="padding: 0.65rem 1.6rem; font-size: 0.95rem;">
                            <i class="fe-check-circle"></i> Save
                        </button>
                        <a href="/admin/order/invoice/<%= order.id %>" class="btn-back-link" style="background: #e0f2fe; color: #0284c7; border-color: #bae6fd;" target="_blank">
                            <i class="fe-eye"></i> View Invoice
                        </a>
                        <a href="/admin/orders" class="btn-back-link">
                            <i class="fe-arrow-left"></i> Back
                        </a>
                    </div>
                </div>

                <div class="edit-order-grid">
                    
                    <!-- LEFT COLUMN: Customer & Order Form (6.8fr) -->
                    <div>
                        <!-- 1. Customer Info Section -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-user" style="color: #10b981;"></i>
                                    <span>1. Customer Details Information</span>
                                </div>
                            </div>
                            <div class="section-body">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                    <div>
                                        <label class="form-label">Customer Name *</label>
                                        <div class="input-group-custom">
                                            <i class="fe-user input-icon"></i>
                                            <input type="text" name="name" class="form-control-custom" value="<%= order.name || '' %>" placeholder="Enter customer name" required>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label">Customer Phone *</label>
                                        <div class="input-group-custom">
                                            <i class="fe-phone input-icon"></i>
                                            <input type="text" name="phone" class="form-control-custom" value="<%= order.phone || '' %>" placeholder="01700000000" required>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <label class="form-label">Customer Delivery Address *</label>
                                    <div class="input-group-custom">
                                        <i class="fe-map-pin input-icon" style="top: 20px;"></i>
                                        <textarea name="address" class="form-control-custom" rows="3" placeholder="Enter full delivery address..." style="padding-left: 2.6rem;" required><%= order.address || '' %></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Delivery & Order Settings Section -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-sliders" style="color: #4a81d4;"></i>
                                    <span>2. Shipping & Order Configuration</span>
                                </div>
                            </div>
                            <div class="section-body">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                    <div>
                                        <label class="form-label">Delivery Area / Shipping Fee</label>
                                        <% 
                                          let currentShipping = 60;
                                          if (order.shippingCharge !== null && order.shippingCharge !== undefined && order.shippingCharge !== '') {
                                            currentShipping = parseFloat(order.shippingCharge);
                                          } else if (String(order.area).includes('120') || String(order.area).toLowerCase().includes('outside')) {
                                            currentShipping = 120;
                                          } else if (String(order.area) === '0' || String(order.area).toLowerCase().includes('free')) {
                                            currentShipping = 0;
                                          }
                                        %>
                                        <select name="area" id="area-select" class="form-ctrl-input form-control-custom" onchange="recalculateTotals()">
                                            <option value="60" <%= (currentShipping === 60) ? 'selected' : '' %>>Inside Dhaka (৳60)</option>
                                            <option value="120" <%= (currentShipping === 120) ? 'selected' : '' %>>Outside Dhaka (৳120)</option>
                                            <option value="0" <%= (currentShipping === 0) ? 'selected' : '' %>>🎉 Free Delivery (৳0)</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="form-label">Order Status Workflow</label>
                                        <select name="status" class="form-control-custom" style="font-weight: 800;">
                                            <option value="Pending" <%= (order.status == 'Pending') ? 'selected' : '' %>>🟡 Pending</option>
                                            <option value="Processing" <%= (order.status == 'Processing') ? 'selected' : '' %>>🔵 Processing</option>
                                            <option value="Confirm" <%= (order.status == 'Confirm') ? 'selected' : '' %>>🟢 Confirm</option>
                                            <option value="In-Courier" <%= (order.status == 'In-Courier') ? 'selected' : '' %>>🚚 In-Courier</option>
                                            <option value="Completed" <%= (order.status == 'Completed') ? 'selected' : '' %>>✅ Completed</option>
                                            <option value="Cancelled" <%= (order.status == 'Cancelled') ? 'selected' : '' %>>🔴 Cancelled</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Highlighted Payment & Advance Card -->
                                <div style="background: #f8fafc; border: 1.5px dashed #10b981; border-radius: 12px; padding: 1.1rem; margin-top: 0.5rem;">
                                    <div style="font-size: 0.85rem; font-weight: 800; color: #065f46; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fe-dollar-sign" style="background: #10b981; color: white; padding: 3px; border-radius: 50%; font-size: 0.75rem;"></i>
                                        Payment Method, Discount & Advance Paid
                                    </div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                                        <div>
                                            <label class="form-label" style="color: #0f172a;">Payment Method</label>
                                            <select name="payment_method" class="form-control-custom" style="background: white; border-color: #cbd5e1;">
                                                <option value="Cash On Delivery" <%= (order.paymentMethod == 'Cash On Delivery') ? 'selected' : '' %>>Cash On Delivery</option>
                                                <option value="bKash" <%= (order.paymentMethod == 'bKash') ? 'selected' : '' %>>bKash Mobile Banking</option>
                                                <option value="Nagad" <%= (order.paymentMethod == 'Nagad') ? 'selected' : '' %>>Nagad Mobile Banking</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="form-label" style="color: #0f172a;">Discount Amount (TK)</label>
                                            <div class="input-group-custom">
                                                <i class="fe-tag input-icon" style="color: #ef4444;"></i>
                                                <input type="number" name="discount" id="discount-input" class="form-control-custom" style="background: white; border-color: #cbd5e1; font-weight: 700;" value="<%= order.discount || 0 %>" placeholder="0" oninput="recalculateTotals()">
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label" style="color: #065f46; font-weight: 800;">Advance Paid (TK) ⚡</label>
                                            <div class="input-group-custom">
                                                <i class="fe-credit-card input-icon" style="color: #10b981; font-weight: 900;"></i>
                                                <input type="number" name="advance_payment" id="advance-input" class="form-control-custom" style="background: #ffffff; border: 2px solid #10b981; font-weight: 800; color: #065f46;" value="<%= order.advance || 0 %>" placeholder="0" oninput="recalculateTotals()">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Admin Remarks Section -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-file-text" style="color: #f7b84b;"></i>
                                    <span>3. Admin Remarks & Notes</span>
                                </div>
                            </div>
                            <div class="section-body">
                                <div>
                                    <label class="form-label">Admin Notes / Customer Instructions</label>
                                    <textarea name="admin_note" class="form-control-custom" rows="2" placeholder="Enter special delivery instructions or internal notes..."><%= order.adminNote || '' %></textarea>
                                </div>
                            </div>
                        </div>


                    </div>

                    <!-- RIGHT COLUMN: Ordered Products & Realtime Calculations (5.2fr) -->
                    <div>
                        <!-- Add/Edit Products Card -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-shopping-bag" style="color: #fe5200;"></i>
                                    <span>Ordered Products Management</span>
                                </div>
                            </div>
                            <div class="section-body" style="padding: 1rem;">
                                
                                <!-- Add Product Select Toolbar -->
                                <div class="add-prod-box">
                                    <select id="add-product-select" class="form-control-custom" style="padding: 0.5rem 0.8rem; font-size: 0.88rem;">
                                        <option value="">-- Select Product To Add --</option>
                                        <% if (typeof allProducts !== 'undefined' && allProducts.length > 0) { %>
                                            <% allProducts.forEach(prod => { %>
                                                <option value="<%= prod.id %>" data-title="<%= prod.title %>" data-price="<%= prod.price %>" data-img="<%= prod.imageUrl %>">
                                                    <%= prod.title %> (৳<%= prod.price %>)
                                                </option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                    <button type="button" class="btn-add-product" onclick="addProductToOrder()">
                                        <i class="fe-plus"></i> Add
                                    </button>
                                </div>

                                <!-- Dynamic Products Table -->
                                <table class="prod-summary-table" id="order-items-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th style="width: 70px; text-align: center;">Qty</th>
                                            <th style="width: 80px; text-align: right;">Total</th>
                                            <th style="width: 40px; text-align: center;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="order-items-body">
                                        <% if (order.products && order.products.length > 0) { %>
                                            <% order.products.forEach((p) => { %>
                                                <% const qty = p.orderItem ? p.orderItem.quantity : 1; %>
                                                <% const itemTotal = p.price * qty; %>
                                                <tr class="product-item-row" data-price="<%= p.price %>">
                                                    <input type="hidden" name="product_ids" value="<%= p.id %>">
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                                                            <img src="<%= p.imageUrl %>" alt="<%= p.title %>" class="item-thumb">
                                                            <div>
                                                                <strong style="display: block; font-size: 0.82rem; color: #0f172a; line-height: 1.3;"><%= p.title %></strong>
                                                                <span style="font-size: 0.75rem; color: #64748b;">৳<%= p.price %> each</span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <input type="number" name="product_quantities" class="item-qty-input" value="<%= qty %>" min="1" oninput="recalculateTotals()">
                                                    </td>
                                                    <td style="text-align: right; font-weight: 800; color: #fe5200;" class="item-line-total">
                                                        ৳<%= itemTotal %>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <button type="button" class="btn-remove-item" onclick="removeProductRow(this)" title="Remove Item">
                                                            <i class="fe-trash-2"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr id="empty-items-row">
                                                <td colspan="4" style="text-align: center; color: #94a3b8; padding: 1.5rem 0;">
                                                    No products added to this order. Select a product above to add.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>

                                <!-- Live Financial Breakdown -->
                                <div style="padding: 1rem 0.5rem 0.5rem;">
                                    <div class="summary-line-item">
                                        <span>Items Subtotal:</span>
                                        <strong id="display-subtotal">৳0</strong>
                                    </div>
                                    <div class="summary-line-item">
                                        <span>Shipping Fee (<span id="display-area-label">60</span> TK):</span>
                                        <strong style="color: #0284c7;" id="display-shipping">+ ৳60</strong>
                                    </div>
                                    <div class="summary-line-item">
                                        <span>Discount:</span>
                                        <strong style="color: #ef4444;" id="display-discount">- ৳0</strong>
                                    </div>
                                    <div class="summary-line-item">
                                        <span>Advance Paid:</span>
                                        <strong style="color: #10b981;" id="display-advance">- ৳0</strong>
                                    </div>
                                    <div class="summary-line-item grand-total">
                                        <span>Net Due Amount:</span>
                                        <span id="display-grand-total">৳0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Assign Staff / Representative Card -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-user-check" style="color: #fe5200;"></i>
                                    <span>Assign Staff / Representative</span>
                                </div>
                            </div>
                            <div class="section-body" style="padding: 1rem;">
                                <label class="form-label">Select Representative User</label>
                                <div class="input-group-custom">
                                    <i class="fe-user input-icon" style="color: #4a81d4;"></i>
                                    <select name="assignee" class="form-control-custom" style="padding-left: 2.6rem; font-weight: 700; background: white;">
                                        <option value="Super Admin" <%= (!order.assignee || order.assignee === 'Super Admin') ? 'selected' : '' %>>👑 Super Admin (Default)</option>
                                        <% if (typeof allUsers !== 'undefined' && allUsers.length > 0) { %>
                                            <% allUsers.forEach(u => { %>
                                                <option value="<%= u.name %>" <%= (order.assignee === u.name) ? 'selected' : '' %>>
                                                    👤 <%= u.name %> (<%= u.email %>)
                                                </option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Info Badge Card -->
                        <div class="section-card">
                            <div class="section-header">
                                <div style="display: flex; align-items: center; gap: 0.6rem;">
                                    <i class="fe-info" style="color: #0284c7;"></i>
                                    <span>Order Metadata</span>
                                </div>
                            </div>
                            <div class="section-body">
                                <div style="font-size: 0.85rem; color: #475569; line-height: 1.6;">
                                    <p style="margin-bottom: 0.4rem;">• <strong>Invoice ID:</strong> #INV-<%= order.id %></p>
                                    <p style="margin-bottom: 0;">• <strong>Current Payment Method:</strong> <%= order.paymentMethod || 'Cash On Delivery' %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <script>
        function recalculateTotals() {
            const rows = document.querySelectorAll('.product-item-row');
            let subtotal = 0;

            rows.forEach(row => {
                const price = parseFloat(row.getAttribute('data-price')) || 0;
                const qtyInput = row.querySelector('.item-qty-input');
                const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
                const lineTotal = price * qty;

                const lineTotalCell = row.querySelector('.item-line-total');
                if (lineTotalCell) {
                    lineTotalCell.innerText = '৳' + lineTotal;
                }
                subtotal += lineTotal;
            });

            const areaSelect = document.getElementById('area-select');
            const shippingFee = (areaSelect && areaSelect.value !== '') ? (parseInt(areaSelect.value) || 0) : 0;

            const discountInput = document.getElementById('discount-input');
            const discountVal = parseFloat(discountInput ? discountInput.value : 0) || 0;

            const advanceInput = document.getElementById('advance-input');
            const advanceVal = parseFloat(advanceInput ? advanceInput.value : 0) || 0;

            const totalBill = Math.max(0, subtotal + shippingFee - discountVal);
            const dueAmount = Math.max(0, totalBill - advanceVal);

            document.getElementById('display-subtotal').innerText = '৳' + subtotal;
            document.getElementById('display-area-label').innerText = shippingFee;
            document.getElementById('display-shipping').innerText = (shippingFee === 0) ? 'Free Delivery (৳0)' : ('+ ৳' + shippingFee);
            document.getElementById('display-discount').innerText = '- ৳' + discountVal;
            document.getElementById('display-advance').innerText = '- ৳' + advanceVal;
            document.getElementById('display-grand-total').innerText = '৳' + dueAmount;
        }

        function removeProductRow(btn) {
            const row = btn.closest('tr');
            if (row) {
                row.remove();
                recalculateTotals();

                const remainingRows = document.querySelectorAll('.product-item-row');
                if (remainingRows.length === 0) {
                    const tbody = document.getElementById('order-items-body');
                    tbody.innerHTML = `
                        <tr id="empty-items-row">
                            <td colspan="4" style="text-align: center; color: #94a3b8; padding: 1.5rem 0;">
                                No products added to this order. Select a product above to add.
                            </td>
                        </tr>
                    `;
                }
            }
        }

        function addProductToOrder() {
            const select = document.getElementById('add-product-select');
            const selectedOpt = select.options[select.selectedIndex];
            
            if (!selectedOpt || !selectedOpt.value) {
                alert('Please select a product from the dropdown!');
                return;
            }

            const pId = selectedOpt.value;
            const pTitle = selectedOpt.getAttribute('data-title');
            const pPrice = parseFloat(selectedOpt.getAttribute('data-price')) || 0;
            const pImg = selectedOpt.getAttribute('data-img') || '/backEnd/assets/images/products/product-1.jpg';

            // Remove empty row message if exists
            const emptyRow = document.getElementById('empty-items-row');
            if (emptyRow) emptyRow.remove();

            // Check if product already exists in table
            const existingRow = document.querySelector(`.product-item-row input[value="${pId}"]`);
            if (existingRow) {
                const row = existingRow.closest('tr');
                const qtyInput = row.querySelector('.item-qty-input');
                if (qtyInput) {
                    qtyInput.value = parseInt(qtyInput.value || 1) + 1;
                }
            } else {
                const tbody = document.getElementById('order-items-body');
                const tr = document.createElement('tr');
                tr.className = 'product-item-row';
                tr.setAttribute('data-price', pPrice);
                tr.innerHTML = `
                    <input type="hidden" name="product_ids" value="${pId}">
                    <td>
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <img src="${pImg}" alt="${pTitle}" class="item-thumb">
                            <div>
                                <strong style="display: block; font-size: 0.82rem; color: #0f172a; line-height: 1.3;">${pTitle}</strong>
                                <span style="font-size: 0.75rem; color: #64748b;">৳${pPrice} each</span>
                            </div>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <input type="number" name="product_quantities" class="item-qty-input" value="1" min="1" oninput="recalculateTotals()">
                    </td>
                    <td style="text-align: right; font-weight: 800; color: #fe5200;" class="item-line-total">
                        ৳${pPrice}
                    </td>
                    <td style="text-align: center;">
                        <button type="button" class="btn-remove-item" onclick="removeProductRow(this)" title="Remove Item">
                            <i class="fe-trash-2"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            }

            select.value = '';
            recalculateTotals();
            if (typeof feather !== 'undefined') feather.replace();
        }

        document.addEventListener("DOMContentLoaded", function() {
            recalculateTotals();
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        });
    </script>
</body>
</html>
