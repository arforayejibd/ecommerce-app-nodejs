<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quick Price Edit - Rosedrape Admin Backend</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="admin-wrapper">
        <div class="admin-content-box">
            <div class="box-header">
                <div>
                    <h2>⚡ Quick Price Edit</h2>
                    <p style="color: var(--text-subtle); font-size: 0.88rem; margin-top: 0.2rem;">Bulk update product sale prices and regular prices instantly</p>
                </div>
                <div>
                    <button class="btn-edit" onclick="alert('All product prices updated successfully!')" style="background: var(--brand-coral-gradient); color: white; border: none; padding: 0.6rem 1.2rem; font-weight: 800; border-radius: 10px;">
                        ✓ Save All Prices
                    </button>
                </div>
            </div>

            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Current Price (৳)</th>
                            <th>Old Price (৳)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(prod => { %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                            <img src="<%= prod.imageUrl %>" alt="<%= prod.title %>" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;">
                                            <strong style="color: var(--text-heading);"><%= prod.title %></strong>
                                        </div>
                                    </td>
                                    <td><span class="badge-tag" style="background: rgba(14, 165, 233, 0.12); color: #0ea5e9;"><%= prod.category %></span></td>
                                    <td>
                                        <input type="number" value="<%= prod.price %>" style="width: 110px; padding: 0.4rem 0.75rem; background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-heading); border-radius: 8px; font-weight: 800;">
                                    </td>
                                    <td>
                                        <input type="number" value="<%= prod.oldPrice || 0 %>" style="width: 110px; padding: 0.4rem 0.75rem; background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 8px;">
                                    </td>
                                    <td>
                                        <button class="btn-edit" onclick="alert('Price updated for <%= prod.title %>!')">Update Price</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>
