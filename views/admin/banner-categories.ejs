<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.name) ? siteSettings.name : 'One Commerce' %> Admin</title>
    <link rel="stylesheet" href="/backEnd/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/icons.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/app.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/sidebar-modern.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        [data-theme="dark"] body {
            background-color: #0f172a;
            color: #f8fafc;
        }
        .content-page {
            margin-top: 85px !important;
            padding: 24px;
            transition: all 0.3s ease;
        }
        .hero-banner-card {
            background: #ffffff !important;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 24px;
        }
        [data-theme="dark"] .hero-banner-card {
            background: #1e293b !important;
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.2);
        }
        .content-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        }
        [data-theme="dark"] .content-card {
            background: #1e293b;
            border-color: rgba(255, 255, 255, 0.08);
        }
        .badge-soft-success {
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            padding: 5px 12px;
            border-radius: 50px;
            font-weight: 700;
        }
        .badge-soft-danger {
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            padding: 5px 12px;
            border-radius: 50px;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="content-page">
        <div class="container-fluid">
            
            <!-- Hero Header Banner -->
            <div class="hero-banner-card d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="api-logo-badge" style="width: 48px; height: 48px; border-radius: 12px; background: rgba(99, 102, 241, 0.12); color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                        <i class="fe-folder"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold m-0 text-slate-900" style="color: #0f172a;">Banner Categories</h3>
                        <p class="text-muted m-0 font-13">Manage homepage slider, promotional banner & ad categories.</p>
                    </div>
                </div>
                <button type="button" class="btn btn-theme-primary" onclick="openCreateModal()"><i class="fe-plus me-1"></i> Add Banner Category</button>
            </div>

            <!-- Data Table Card -->
            <div class="content-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="table-light">
                                <th style="width: 60px;">SL</th>
                                <th>Category Name</th>
                                <th>Status</th>
                                <th style="width: 160px;" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach((cat, index) => { %>
                                    <tr>
                                        <td class="fw-bold"><%= index + 1 %></td>
                                        <td class="fw-semibold" style="color: #0f172a;"><%= cat.name %></td>
                                        <td>
                                            <% if (cat.status == 1) { %>
                                                <span class="badge-soft-success font-12">Active</span>
                                            <% } else { %>
                                                <span class="badge-soft-danger font-12">Inactive</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                <form action="/admin/banner-category/status" method="POST" class="d-inline">
                                                    <input type="hidden" name="id" value="<%= cat.id %>">
                                                    <% if (cat.status == 1) { %>
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Set Inactive"><i class="fe-thumbs-down"></i></button>
                                                    <% } else { %>
                                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Set Active"><i class="fe-thumbs-up"></i></button>
                                                    <% } %>
                                                </form>

                                                <button type="button" class="btn btn-sm btn-theme-secondary" onclick="openEditModal('<%= cat.id %>', '<%= cat.name.replace(/'/g, "\\'") %>', '<%= cat.status %>')" title="Edit"><i class="fe-edit"></i></button>

                                                <form action="/admin/banner-category/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?')">
                                                    <input type="hidden" name="id" value="<%= cat.id %>">
                                                    <button type="submit" class="btn btn-sm btn-theme-danger" title="Delete"><i class="fe-trash-2"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No banner categories found. Click "Add Banner Category" above.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- Create Category Modal -->
    <div id="createCategoryModal" class="modal fade" tabindex="-1" role="dialog" style="display: none; background: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                <div class="modal-header d-flex align-items-center justify-content-between p-3" style="border-bottom: 1px dashed #e2e8f0;">
                    <h5 class="modal-title fw-bold m-0" style="color: #0f172a;"><i class="fe-plus-circle me-2 text-indigo"></i> Create Banner Category</h5>
                    <button type="button" class="btn-close" onclick="closeCreateModal()"></button>
                </div>
                <form action="/admin/banner-category/create" method="POST">
                    <div class="modal-body p-3">
                        <div class="mb-3">
                            <label class="form-label">Category Name *</label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Main Slider Banner" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" name="status" value="1" checked>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-3" style="border-top: 1px dashed #e2e8f0;">
                        <button type="button" class="btn btn-theme-secondary" onclick="closeCreateModal()">Cancel</button>
                        <button type="submit" class="btn btn-theme-primary"><i class="fe-save me-1"></i> Save Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Category Modal -->
    <div id="editCategoryModal" class="modal fade" tabindex="-1" role="dialog" style="display: none; background: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                <div class="modal-header d-flex align-items-center justify-content-between p-3" style="border-bottom: 1px dashed #e2e8f0;">
                    <h5 class="modal-title fw-bold m-0" style="color: #0f172a;"><i class="fe-edit me-2 text-indigo"></i> Edit Banner Category</h5>
                    <button type="button" class="btn-close" onclick="closeEditModal()"></button>
                </div>
                <form action="/admin/banner-category/edit" method="POST">
                    <input type="hidden" name="id" id="edit_cat_id">
                    <div class="modal-body p-3">
                        <div class="mb-3">
                            <label class="form-label">Category Name *</label>
                            <input type="text" name="name" id="edit_cat_name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" name="status" id="edit_cat_status" value="1">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer p-3" style="border-top: 1px dashed #e2e8f0;">
                        <button type="button" class="btn btn-theme-secondary" onclick="closeEditModal()">Cancel</button>
                        <button type="submit" class="btn btn-theme-primary"><i class="fe-save me-1"></i> Update Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/backEnd/assets/js/vendor.min.js"></script>
    <script src="/backEnd/assets/js/app.min.js"></script>
    <script>
        function openCreateModal() {
            const modal = document.getElementById('createCategoryModal');
            modal.style.display = 'block';
            modal.classList.add('show');
        }
        function closeCreateModal() {
            const modal = document.getElementById('createCategoryModal');
            modal.style.display = 'none';
            modal.classList.remove('show');
        }
        function openEditModal(id, name, status) {
            document.getElementById('edit_cat_id').value = id;
            document.getElementById('edit_cat_name').value = name;
            document.getElementById('edit_cat_status').checked = (status == 1 || status == '1');
            const modal = document.getElementById('editCategoryModal');
            modal.style.display = 'block';
            modal.classList.add('show');
        }
        function closeEditModal() {
            const modal = document.getElementById('editCategoryModal');
            modal.style.display = 'none';
            modal.classList.remove('show');
        }
    </script>
</body>
</html>
