<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= moduleTitle %> - OneCommerce Admin Backend</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="admin-wrapper">
        <div class="admin-content-box">
            <div class="box-header">
                <div>
                    <h2><%= moduleIcon %> <%= moduleTitle %></h2>
                    <p style="color: var(--text-subtle); font-size: 0.88rem; margin-top: 0.2rem;"><%= moduleDescription %></p>
                </div>
                <div>
                    <button class="btn-edit" onclick="alert('<%= moduleTitle %> settings updated!')" style="background: var(--brand-coral-gradient); color: white; border: none; padding: 0.6rem 1.2rem; font-weight: 800; border-radius: 10px;">
                        ✓ Save Changes
                    </button>
                </div>
            </div>

            <!-- Active Status Card -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 16px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.15); color: #10b981; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <%= moduleIcon %>
                    </div>
                    <div>
                        <h4 style="font-size: 1rem; font-weight: 800; color: var(--text-heading);"><%= moduleTitle %> Active Status</h4>
                        <p style="font-size: 0.82rem; color: var(--text-subtle);">Module is active and configured for store operations</p>
                    </div>
                </div>
                <div class="status-pill">
                    <span class="pulse-dot"></span>
                    <span>ACTIVE</span>
                </div>
            </div>

            <!-- Configuration Form Inputs -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div style="background: var(--bg-input); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 16px;">
                    <label style="display: block; font-weight: 800; color: var(--text-heading); margin-bottom: 0.5rem; font-size: 0.9rem;">Primary Config Key</label>
                    <input type="text" value="KEY_CONFIG_<%= moduleTitle.toUpperCase().replace(/\s+/g, '_') %>" style="width: 100%; padding: 0.75rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-heading); border-radius: 10px; outline: none;">
                </div>

                <div style="background: var(--bg-input); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 16px;">
                    <label style="display: block; font-weight: 800; color: var(--text-heading); margin-bottom: 0.5rem; font-size: 0.9rem;">Status Mode</label>
                    <select style="width: 100%; padding: 0.75rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-heading); border-radius: 10px; outline: none;">
                        <option value="enabled">Enabled (Live)</option>
                        <option value="disabled">Disabled (Maintenance)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
