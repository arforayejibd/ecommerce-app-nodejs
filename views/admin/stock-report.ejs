<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stock Inventory Report - OneCommerce Admin Backend</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="admin-wrapper">
        <div class="admin-content-box">
            <div class="box-header">
                <div>
                    <h2>📈 Stock Inventory Report</h2>
                    <p style="color: var(--text-subtle); font-size: 0.88rem; margin-top: 0.2rem;">Current product inventory levels, stock availability, and re-order alerts</p>
                </div>
            </div>

            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Current Price</th>
                            <th>Stock Quantity</th>
                            <th>Stock Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(prod => { %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                            <img src="<%= prod.imageUrl %>" alt="<%= prod.title %>" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;">
                                            <strong style="color: var(--text-heading);"><%= prod.title %></strong>
                                        </div>
                                    </td>
                                    <td><span class="badge-tag" style="background: rgba(14, 165, 233, 0.12); color: #0ea5e9;"><%= prod.category %></span></td>
                                    <td><strong style="color: var(--text-heading);">৳ <%= prod.price %></strong></td>
                                    <td><strong style="color: #10b981; font-size: 1.05rem;">45 Units</strong></td>
                                    <td>
                                        <span class="badge-tag" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                            In Stock
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/edit-product/<%= prod.id %>" class="btn-edit">Edit Stock</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>
