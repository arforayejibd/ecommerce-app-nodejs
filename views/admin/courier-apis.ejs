<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - OneCommerce Admin</title>
    <link rel="stylesheet" href="/backEnd/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/icons.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/app.min.css">
    <link rel="stylesheet" href="/backEnd/assets/css/sidebar-modern.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        [data-theme="dark"] body {
            background-color: #0f172a;
            color: #f8fafc;
        }
        .content-page {
            margin-top: 85px !important;
            padding: 24px;
            transition: all 0.3s ease;
        }
        .hero-banner-card {
            background: #ffffff !important;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 24px;
        }
        [data-theme="dark"] .hero-banner-card {
            background: #1e293b !important;
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.2);
        }
        .api-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
            height: 100%;
            transition: all 0.25s ease;
        }
        [data-theme="dark"] .api-card {
            background: #1e293b;
            border-color: rgba(255, 255, 255, 0.08);
        }
        .api-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            margin-bottom: 20px;
            border-bottom: 1px dashed #e2e8f0;
        }
        [data-theme="dark"] .api-card-header {
            border-bottom-color: rgba(255, 255, 255, 0.08);
        }
        .api-logo-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #475569;
            margin-bottom: 6px;
        }
        [data-theme="dark"] .form-label {
            color: #94a3b8;
        }
        .form-control {
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }
        [data-theme="dark"] .form-control {
            background: #0f172a;
            border-color: rgba(255, 255, 255, 0.12);
            color: #f8fafc;
        }
        .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
        .btn-indigo {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #ffffff;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
            transition: all 0.2s ease;
        }
        .btn-indigo:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(99, 102, 241, 0.35);
            color: #ffffff;
        }
        .form-check-input:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }
    </style>
</head>
<body>

    <%- include('../includes/admin-navigation.ejs') %>

    <div class="content-page">
        <div class="container-fluid">
            
            <form id="courier-apis-form" action="/admin/courierapi/update" method="POST">
                <!-- Hero Header Banner -->
                <div class="hero-banner-card d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="api-logo-badge" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                            <i class="fe-truck"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold m-0" style="color: #0f172a;">Courier API Integration</h3>
                            <p class="text-muted m-0 font-13">Configure Steadfast Courier & Pathao Merchant API credentials for 1-click automatic parcel creation.</p>
                        </div>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-theme-primary"><i class="fe-save me-1"></i> Save Courier APIs</button>
                    </div>
                </div>

                <!-- Grid Layout -->
                <div class="row g-4">
                    
                    <!-- Steadfast Courier API -->
                    <div class="col-lg-6">
                        <div class="api-card">
                            <div class="api-card-header">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="api-logo-badge" style="background: rgba(99, 102, 241, 0.12); color: #6366f1;">
                                        <i class="fe-package"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold m-0" style="color: #6366f1;">Steadfast Courier API</h4>
                                        <span class="font-12 text-muted">Automatic parcel creation & tracking</span>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" id="steadfast_status" name="steadfast_status" <%= steadfast && steadfast.status ? 'checked' : '' %>>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Steadfast API Key *</label>
                                <input type="text" class="form-control" name="steadfast_api_key" value="<%= steadfast ? steadfast.api_key : 'st_live_key_938472910' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Steadfast Secret Key *</label>
                                <input type="password" class="form-control" name="steadfast_secret_key" value="<%= steadfast ? steadfast.secret_key : 'st_secret_key_83749102' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Base URL *</label>
                                <input type="text" class="form-control" name="steadfast_url" value="<%= steadfast ? steadfast.url : 'https://portal.packzy.com/api/v1' %>" required>
                            </div>
                        </div>
                    </div>

                    <!-- Pathao Courier API -->
                    <div class="col-lg-6">
                        <div class="api-card">
                            <div class="api-card-header">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="api-logo-badge" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;">
                                        <i class="fe-navigation"></i>
                                    </div>
                                    <div>
                                        <h4 class="fw-bold m-0" style="color: #ef4444;">Pathao Courier API</h4>
                                        <span class="font-12 text-muted">Pathao merchant Hermes parcel API</span>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" id="pathao_status" name="pathao_status" <%= pathao && pathao.status ? 'checked' : '' %>>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Base URL *</label>
                                <input type="text" class="form-control" name="pathao_url" value="<%= pathao ? pathao.url : 'https://api-hermes.pathao.com' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Client ID *</label>
                                <input type="text" class="form-control" name="pathao_api_key" value="<%= pathao ? pathao.api_key : 'pathao_client_id_83749' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Client Secret *</label>
                                <input type="password" class="form-control" name="pathao_secret_key" value="<%= pathao ? pathao.secret_key : 'pathao_client_secret_938471' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Secret Token / Bearer Token</label>
                                <input type="text" class="form-control" name="pathao_token" value="<%= pathao ? pathao.token : 'bearer_token_pathao_live_93847291' %>">
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <script src="/backEnd/assets/js/vendor.min.js"></script>
    <script src="/backEnd/assets/js/app.min.js"></script>
</body>
</html>
