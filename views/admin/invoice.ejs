<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 20px;
            color: #0f172a;
        }

        .invoice-wrapper {
            max-width: 21cm;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
        }

        .no-print-bar {
            max-width: 21cm;
            margin: 0 auto 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-print {
            background: #10b981;
            color: white;
            padding: 10px 24px;
            border-radius: 30px;
            border: none;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back {
            background: #64748b;
            color: white;
            padding: 10px 20px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .info-table td {
            border: 1px solid #cbd5e1;
            padding: 12px;
            vertical-align: top;
            font-size: 13px;
        }

        .items-table {
            margin-top: 15px;
        }

        .items-table th {
            background: #0f172a;
            color: #ffffff;
            padding: 10px;
            border: 1px solid #0f172a;
            text-align: left;
            font-size: 13px;
        }

        .items-table td {
            border: 1px solid #cbd5e1;
            padding: 10px;
            font-size: 13px;
        }

        .summary-row td {
            border: none !important;
        }

        .summary-label {
            font-weight: 700;
            border: 1px solid #cbd5e1 !important;
        }

        .summary-value {
            font-weight: 700;
            border: 1px solid #cbd5e1 !important;
        }

        .grand-total-bg {
            background: #0f172a !important;
            color: #ffffff !important;
        }

        @media print {
            .no-print-bar {
                display: none !important;
            }
            body {
                background: white;
                padding: 0;
            }
            .invoice-wrapper {
                box-shadow: none;
                border: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="no-print-bar">
        <a href="/admin/orders" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Back To Orders</a>
        <button onclick="window.print()" class="btn-print"><i class="fa-solid fa-print"></i> Print Invoice</button>
    </div>

    <div class="invoice-wrapper">
        <table class="info-table">
            <tr>
                <td style="width: 33%;">
                    <h2 style="margin: 0 0 5px 0; color: #fe5200; font-weight: 900;">One Commerce</h2>
                    <p style="margin: 3px 0; color: #475569;">Kazipara Mirpur Dhaka</p>
                    <p style="margin: 3px 0; color: #475569;">Phone: 01968465676</p>
                    <p style="margin: 3px 0; color: #475569;">Email: support@onecommercebd.com</p>
                </td>
                <td style="width: 34%;">
                    <strong style="text-transform: uppercase; color: #0f172a; display: block; margin-bottom: 5px;">Customer Info</strong>
                    <p style="margin: 3px 0; font-weight: 700;"><%= order.name || 'Customer' %></p>
                    <p style="margin: 3px 0;"><%= order.phone || '01700000000' %></p>
                    <p style="margin: 3px 0; line-height: 1.3;"><%= order.address || 'Dhaka, Bangladesh' %></p>
                    <p style="margin: 3px 0; color: #0284c7; font-weight: 600;"><%= order.area || '60' %> TK Shipping Area</p>
                </td>
                <td style="width: 33%;">
                    <p style="margin: 3px 0;">Invoice ID: <strong style="color: #fe5200;">#INV-<%= order.id %></strong></p>
                    <p style="margin: 3px 0;">Invoice Date: <strong><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></strong></p>
                    <p style="margin: 3px 0;">Payment Method: <strong style="text-transform: uppercase;"><%= order.paymentMethod || 'CASH ON DELIVERY' %></strong></p>
                    <p style="margin: 3px 0;">Status: <strong style="color: #10b981; text-transform: uppercase;"><%= order.status || 'Pending' %></strong></p>
                </td>
            </tr>
        </table>

        <% let itemsSubtotal = 0; %>
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 40px;">SL</th>
                    <th>Product</th>
                    <th style="width: 90px; text-align: right;">Price</th>
                    <th style="width: 60px; text-align: center;">Qty</th>
                    <th style="width: 100px; text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <% if (order.products && order.products.length > 0) { %>
                    <% order.products.forEach((product, idx) => { %>
                        <% const itemQty = product.orderItem ? product.orderItem.quantity : 1; %>
                        <% const itemTotal = product.price * itemQty; %>
                        <% itemsSubtotal += itemTotal; %>
                        <tr>
                            <td><%= idx + 1 %></td>
                            <td><strong><%= product.title %></strong></td>
                            <td style="text-align: right;">৳<%= product.price %></td>
                            <td style="text-align: center;"><%= itemQty %></td>
                            <td style="text-align: right; font-weight: 700;">৳<%= itemTotal %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td>1</td>
                        <td><strong>Standard Order Item</strong></td>
                        <td style="text-align: right;">৳<%= (order.amount || 750) - (order.shippingCharge || 60) %></td>
                        <td style="text-align: center;">1</td>
                        <td style="text-align: right; font-weight: 700;">৳<%= (order.amount || 750) - (order.shippingCharge || 60) %></td>
                    </tr>
                    <% itemsSubtotal = (order.amount || 750) - (order.shippingCharge || 60); %>
                <% } %>

                <tr>
                    <td colspan="3" style="border: none;"></td>
                    <td class="summary-label">SubTotal</td>
                    <td class="summary-value" style="text-align: right;">৳<%= itemsSubtotal %></td>
                </tr>
                <tr>
                    <td colspan="3" style="border: none;"></td>
                    <td class="summary-label">Shipping(+)</td>
                    <td class="summary-value" style="text-align: right; color: #0284c7;">৳<%= parseInt(order.area) || order.shippingCharge || 60 %></td>
                </tr>
                <tr>
                    <td colspan="3" style="border: none;"></td>
                    <td class="summary-label">Discount(-)</td>
                    <td class="summary-value" style="text-align: right; color: #ef4444;">৳<%= order.discount || 0 %></td>
                </tr>
                <tr>
                    <td colspan="3" style="border: none;"></td>
                    <td class="summary-label grand-total-bg">Final Total</td>
                    <td class="summary-value grand-total-bg" style="text-align: right;">৳<%= itemsSubtotal + (parseInt(order.area) || order.shippingCharge || 60) - (order.discount || 0) %></td>
                </tr>
            </tbody>
        </table>

        <div style="text-align: center; padding-top: 30px; margin-top: 30px; border-top: 1px solid #e2e8f0; color: #64748b; font-style: italic; font-size: 13px;">
            * This is a computer generated invoice, does not require any signature.
        </div>
    </div>

</body>
</html>
