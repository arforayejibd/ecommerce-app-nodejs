    [data-theme="dark"] .nav-second-level li.active > a.sidebar-link,
    [data-theme="dark"] .nav-second-level li a.sidebar-link.active {
        background: rgba(99, 102, 241, 0.22) !important;
        color: #a5b4fc !important;
    }
</style>

