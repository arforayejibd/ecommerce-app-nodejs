<style>
    /* Exact Rosedrape Layout Engine */
    #wrapper {
        display: flex;
        width: 100%;
        min-height: 100vh;
    }

    .content-page {
        margin-left: 260px;
        margin-top: 70px;
        padding: 24px;
        width: calc(100% - 260px);
        min-height: calc(100vh - 70px);
        box-sizing: border-box;
    }

    @media (max-width: 991.98px) {
        .content-page {
            margin-left: 0 !important;
            width: 100% !important;
            margin-top: 80px !important;
            padding: 14px !important;
        }

        .topbar-logo-box {
            width: 140px !important;
            min-width: 120px !important;
            padding-left: 8px !important;
            padding-right: 4px !important;
            display: flex !important;
            align-items: center !important;
            height: 100% !important;
        }

        .topbar-logo-box img {
            max-width: 120px !important;
            max-height: 38px !important;
            height: auto !important;
            width: auto !important;
            object-fit: contain !important;
        }

        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 1040;
            display: none;
            transition: opacity 0.3s ease;
        }

        body.sidebar-enable .sidebar-overlay {
            display: block;
        }
    }

    /* ── USER PROFILE DROPDOWN ── */
    #user-profile-dropdown-wrap {
        position: relative;
    }

    .user-profile-trigger {
        transition: all 0.2s ease;
        border-radius: 50px !important;
        padding: 4px 10px !important;
    }

    [data-theme="dark"] .user-profile-trigger:hover {
        background: rgba(255,255,255,0.06) !important;
    }

    [data-theme="light"] .user-profile-trigger:hover {
        background: rgba(99,102,241,0.07) !important;
    }

    .user-profile-dropdown {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 220px;
        border-radius: 16px;
        padding: 0.5rem;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px) scale(0.97);
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
        pointer-events: none;
    }

    .user-profile-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
        pointer-events: auto;
    }

    [data-theme="dark"] .user-profile-dropdown {
        background: #1e293b;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 50px rgba(0,0,0,0.45);
    }

    [data-theme="light"] .user-profile-dropdown {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.07);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    }

    .user-dropdown-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0.85rem;
        border-radius: 12px;
        margin-bottom: 0.25rem;
    }

    [data-theme="dark"] .user-dropdown-header {
        background: rgba(255,255,255,0.04);
    }

    [data-theme="light"] .user-dropdown-header {
        background: #f8fafc;
    }

    .user-dropdown-name {
        font-weight: 700;
        font-size: 0.875rem;
    }

    .user-dropdown-role {
        font-size: 0.75rem;
        font-weight: 500;
    }

    [data-theme="dark"] .user-dropdown-name { color: #f1f5f9; }
    [data-theme="dark"] .user-dropdown-role { color: #64748b; }
    [data-theme="light"] .user-dropdown-name { color: #0f172a; }
    [data-theme="light"] .user-dropdown-role { color: #94a3b8; }

    .user-dropdown-divider {
        height: 1px;
        margin: 0.35rem 0.5rem;
    }

    [data-theme="dark"] .user-dropdown-divider { background: rgba(255,255,255,0.07); }
    [data-theme="light"] .user-dropdown-divider { background: rgba(0,0,0,0.06); }

    .user-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        padding: 0.6rem 0.85rem;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        background: transparent;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.18s ease;
        text-align: left;
    }

    [data-theme="dark"] .user-dropdown-item { color: #94a3b8; }
    [data-theme="light"] .user-dropdown-item { color: #475569; }

    [data-theme="dark"] .user-dropdown-item:hover {
        background: rgba(99,102,241,0.12);
        color: #a5b4fc;
    }

    [data-theme="light"] .user-dropdown-item:hover {
        background: rgba(99,102,241,0.07);
        color: #4f46e5;
    }

    .user-dropdown-icon-wrap {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
        transition: all 0.18s ease;
    }

    [data-theme="dark"] .user-dropdown-icon-wrap { background: rgba(255,255,255,0.06); color: #94a3b8; }
    [data-theme="light"] .user-dropdown-icon-wrap { background: #f1f5f9; color: #64748b; }

    [data-theme="dark"] .user-dropdown-item:hover .user-dropdown-icon-wrap {
        background: rgba(99,102,241,0.2);
        color: #818cf8;
    }

    [data-theme="light"] .user-dropdown-item:hover .user-dropdown-icon-wrap {
        background: rgba(99,102,241,0.12);
        color: #6366f1;
    }

    .user-dropdown-logout { color: #ef4444 !important; }
    .user-dropdown-logout .user-dropdown-icon-wrap { color: #ef4444 !important; }

    [data-theme="dark"] .user-dropdown-logout:hover {
        background: rgba(239,68,68,0.1) !important;
        color: #f87171 !important;
    }

    [data-theme="light"] .user-dropdown-logout:hover {
        background: rgba(239,68,68,0.07) !important;
        color: #dc2626 !important;
    }

    [data-theme="dark"] .user-dropdown-logout:hover .logout-icon {
        background: rgba(239,68,68,0.18) !important;
        color: #f87171 !important;
    }

    /* ── ICON BOX CENTERING & ALIGNMENT ── */
    .menu-icon-box {
        width: 36px !important;
        height: 36px !important;
        border-radius: 10px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 17px !important;
        margin-right: 0.85rem !important;
        flex-shrink: 0 !important;
        transition: all 0.25s ease !important;
        line-height: 1 !important;
    }

    .menu-icon-box i,
    .menu-icon-box svg {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        margin: 0 !important;
        padding: 0 !important;
        line-height: 1 !important;
        width: auto !important;
        height: auto !important;
    }

    /* ── ACTIVE SIDEBAR MENU ITEM STYLING (WHITE ICON FORCE FOR ALL ACTIVE/OPEN) ── */
    #side-menu > li.active > a.sidebar-link,
    #side-menu > li.open > a.sidebar-link,
    #side-menu > li.has-submenu.open > a.sidebar-link,
    #side-menu > li > a.sidebar-link.active {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35) !important;
        font-weight: 700 !important;
    }

    #side-menu > li.active > a.sidebar-link .menu-icon-box,
    #side-menu > li.active > a.sidebar-link .menu-icon-box i,
    #side-menu > li.open > a.sidebar-link .menu-icon-box,
    #side-menu > li.open > a.sidebar-link .menu-icon-box i,
    #side-menu > li.has-submenu.open > a.sidebar-link .menu-icon-box,
    #side-menu > li.has-submenu.open > a.sidebar-link .menu-icon-box i,
    #side-menu > li > a.sidebar-link.active .menu-icon-box,
    #side-menu > li > a.sidebar-link.active .menu-icon-box i {
        background: rgba(255, 255, 255, 0.22) !important;
        color: #ffffff !important;
        box-shadow: none !important;
    }

    #side-menu > li.active > a.sidebar-link .menu-text,
    #side-menu > li.open > a.sidebar-link .menu-text,
    #side-menu > li.has-submenu.open > a.sidebar-link .menu-text,
    #side-menu > li > a.sidebar-link.active .menu-text {
        color: #ffffff !important;
        font-weight: 700 !important;
    }

    /* Submenu Clean Style - No Lines, No Dashes */
    .nav-second-level {
        padding: 0.2rem 0 0.35rem 0 !important;
        margin: 0.25rem 10px 0.5rem 14px !important;
        list-style: none !important;
        position: relative !important;
        border-left: none !important;
    }

    .nav-second-level li {
        margin-bottom: 0.25rem !important;
