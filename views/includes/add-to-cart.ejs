<form action="/cart" method="POST" style="width: 100%;" data-prod-id="<%= product.id %>" data-prod-title="<%= product.title %>" data-prod-price="<%= product.price %>">
    <input type="hidden" name="productId" value="<%= product.id %>">
    <button class="btn btn-primary" type="submit">
        <span>🛒 <%= typeof __ !== 'undefined' ? __('Add to Cart') : 'Add to Cart' %></span>
    </button>
</form>