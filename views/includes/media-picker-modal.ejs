<!-- GLOBAL MEDIA PICKER MODAL -->
<style>
    .picker-backdrop {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center; justify-content: center;
        z-index: 9999;
    }
    .picker-container {
        background: #ffffff;
        border-radius: 20px;
        width: 92%; max-width: 960px;
        height: 85vh; max-height: 720px;
        display: flex; flex-direction: column;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    .picker-header {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff;
    }
    .picker-tab-bar {
        display: flex; gap: 0.5rem; background: #f8fafc;
        padding: 0.75rem 1.5rem; border-bottom: 1px solid #e2e8f0;
    }
    .picker-tab-btn {
        padding: 0.55rem 1.25rem; border-radius: 10px; border: 1px solid transparent;
        font-weight: 700; font-size: 0.88rem; cursor: pointer; color: #64748b;
        background: transparent; transition: all 0.2s ease;
        display: inline-flex; align-items: center;
    }
    .picker-tab-btn.active {
        background: #ffffff; color: #6366f1; border-color: #cbd5e1;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .picker-body {
        flex: 1; padding: 1.5rem; overflow-y: auto; background: #f8fafc;
        display: flex; flex-direction: column;
    }
    #pickerTabUploadContent {
        width: 100%; height: 100%; min-height: 380px; flex: 1;
        display: flex; flex-direction: column;
    }
    #pickerTabLibraryContent {
        width: 100%; height: 100%; flex: 1;
        display: flex; flex-direction: column;
    }
    .picker-drop-zone-full {
        width: 100%; flex: 1; min-height: 360px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 3rem 2rem; text-align: center; border: 2px dashed #cbd5e1;
        border-radius: 16px; background: #ffffff; cursor: pointer;
        transition: all 0.2s ease; box-sizing: border-box;
    }
    .picker-drop-zone-full:hover {
        border-color: #6366f1; background: #f8fafc;
    }
    .picker-footer {
        padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0;
        display: flex; align-items: center; justify-content: space-between;
        background: #ffffff;
    }
    .picker-btn-cancel {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 0.65rem 1.25rem;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .picker-btn-cancel:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .picker-btn-select {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        font-weight: 800;
        font-size: 0.88rem;
        padding: 0.65rem 1.35rem;
        border-radius: 12px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .picker-btn-select:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4);
    }
    .picker-btn-select:disabled {
        background: #cbd5e1 !important;
        color: #94a3b8 !important;
        box-shadow: none !important;
        cursor: not-allowed !important;
        transform: none !important;
    }
    .picker-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 1rem; flex: 1; align-content: start;
    }
    .picker-card {
        background: #ffffff; border-radius: 12px; border: 2px solid #e2e8f0;
        overflow: hidden; cursor: pointer; position: relative; height: 130px;
        transition: all 0.2s ease;
    }
    .picker-card:hover { border-color: #cbd5e1; transform: translateY(-2px); }
    .picker-card.selected { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2); }
    .picker-card img { width: 100%; height: 100%; object-fit: cover; }
    .picker-card-check {
        position: absolute; top: 6px; right: 6px; background: #6366f1; color: white;
        width: 22px; height: 22px; border-radius: 50%; display: none;
        align-items: center; justify-content: center; font-size: 11px; font-weight: bold;
    }
    .picker-card.selected .picker-card-check { display: flex; }
</style>

<div id="globalMediaPickerModal" class="picker-backdrop">
    <div class="picker-container">
        <div class="picker-header">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(99,102,241,0.12); color: #6366f1; display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                </div>
                <h4 style="margin: 0; font-weight: 800; font-size: 1.15rem; color: #0f172a;">Media Asset Selector</h4>
            </div>
            <button type="button" onclick="closeMediaPicker()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <div class="picker-tab-bar">
            <button type="button" id="pickerTabUploadBtn" class="picker-tab-btn" onclick="switchPickerTab('upload')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Upload New File
            </button>
            <button type="button" id="pickerTabLibraryBtn" class="picker-tab-btn active" onclick="switchPickerTab('library')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.4rem;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg> Media Library
            </button>
        </div>

        <div class="picker-body">
            <!-- Tab 1: Upload File -->
            <div id="pickerTabUploadContent" style="display: none;">
                <div class="picker-drop-zone-full" onclick="document.getElementById('pickerFileInput').click()">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                    <p style="margin: 0; font-weight: 800; font-size: 1.15rem; color: #0f172a;" id="pickerSelectedFileName">Click to browse or drag & drop image from computer</p>
                    <span style="font-size: 0.88rem; color: #94a3b8; margin-top: 0.5rem; display: block;">JPG, PNG, WEBP, GIF, SVG supported</span>
                    <input type="file" id="pickerFileInput" accept="image/*" style="display: none;" onchange="handlePickerFileSelect(this)">
                </div>

                <div id="pickerUploadPreviewBox" style="display: none; margin-top: 1.25rem; border-radius: 14px; overflow: hidden; border: 1px solid #e2e8f0; height: 180px; background: #ffffff; align-items: center; justify-content: center;">
                    <img id="pickerUploadPreviewImg" src="" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
            </div>

            <!-- Tab 2: Existing Media Library -->
            <div id="pickerTabLibraryContent">
                <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                    <input type="text" id="pickerSearchInput" placeholder="Search media title..." class="form-control-custom" style="max-width: 280px;" oninput="filterPickerGrid(this.value)">
                    <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;" id="pickerCountText">0 Assets</span>
                </div>
                <div class="picker-grid" id="pickerMediaGrid">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </div>

        <div class="picker-footer">
            <div style="font-size: 0.82rem; color: #64748b; font-weight: 600;" id="pickerSelectedUrlText">No image selected</div>
            <div style="display: flex; gap: 0.6rem;">
                <button type="button" class="picker-btn-cancel" onclick="closeMediaPicker()">Cancel</button>
                <button type="button" class="picker-btn-select" id="pickerSelectBtn" disabled onclick="confirmPickerSelection()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Use Selected Image
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let globalPickerCallback = null;
    let globalSelectedUrl = '';
    let globalMediaItems = [];

    window.openMediaPicker = function(callback) {
        globalPickerCallback = callback;
        globalSelectedUrl = '';
        document.getElementById('pickerSelectedUrlText').innerText = 'No image selected';
        document.getElementById('pickerSelectBtn').disabled = true;
        document.getElementById('pickerFileInput').value = '';
        document.getElementById('pickerSelectedFileName').innerText = 'Click to browse or drag & drop image from computer';
        document.getElementById('pickerUploadPreviewBox').style.display = 'none';

        switchPickerTab('library');
        fetchPickerMedia();
        document.getElementById('globalMediaPickerModal').style.display = 'flex';
    };

    window.closeMediaPicker = function() {
        document.getElementById('globalMediaPickerModal').style.display = 'none';
        globalPickerCallback = null;
    };

    function switchPickerTab(tab) {
        const uploadTabBtn = document.getElementById('pickerTabUploadBtn');
        const libraryTabBtn = document.getElementById('pickerTabLibraryBtn');
        const uploadContent = document.getElementById('pickerTabUploadContent');
        const libraryContent = document.getElementById('pickerTabLibraryContent');

        if (tab === 'upload') {
            uploadTabBtn.classList.add('active');
            libraryTabBtn.classList.remove('active');
            uploadContent.style.display = 'flex';
            libraryContent.style.display = 'none';
        } else {
            libraryTabBtn.classList.add('active');
            uploadTabBtn.classList.remove('active');
            libraryContent.style.display = 'flex';
            uploadContent.style.display = 'none';
        }
    }

    function fetchPickerMedia() {
        fetch('/admin/api/media-list')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    globalMediaItems = data.mediaList || [];
                    renderPickerGrid(globalMediaItems);
                }
            })
            .catch(err => console.error("Error loading media list:", err));
    }

    function renderPickerGrid(items) {
        const grid = document.getElementById('pickerMediaGrid');
        const countText = document.getElementById('pickerCountText');
        countText.innerText = items.length + " Assets";

        if (!items || items.length === 0) {
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #94a3b8; padding: 2rem;">No media assets found</div>';
            return;
        }

        grid.innerHTML = items.map(m => `
            <div class="picker-card ${globalSelectedUrl === m.url ? 'selected' : ''}" onclick="selectPickerCard('${m.url}', this)" title="${m.title}">
                <img src="${m.url}" alt="${m.title}" loading="lazy" decoding="async">
                <div class="picker-card-check">✓</div>
            </div>
        `).join('');
    }

    function filterPickerGrid(keyword) {
        const filtered = globalMediaItems.filter(m => 
            (m.title && m.title.toLowerCase().includes(keyword.toLowerCase())) ||
            (m.url && m.url.toLowerCase().includes(keyword.toLowerCase()))
        );
        renderPickerGrid(filtered);
    }

    function selectPickerCard(url, cardEl) {
        document.querySelectorAll('.picker-card').forEach(c => c.classList.remove('selected'));
        cardEl.classList.add('selected');
        globalSelectedUrl = url;
        document.getElementById('pickerSelectedUrlText').innerText = 'Selected: ' + url.split('/').pop();
        document.getElementById('pickerSelectBtn').disabled = false;
    }

    function handlePickerFileSelect(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            document.getElementById('pickerSelectedFileName').innerText = "Uploading: " + file.name;

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('pickerUploadPreviewImg').src = e.target.result;
                document.getElementById('pickerUploadPreviewBox').style.display = 'flex';

                fetch('/admin/media/upload', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        title: file.name.split('.')[0].replace(/[-_]/g, ' '),
                        base64Data: e.target.result,
                        filename: file.name.split('.')[0]
                    })
                })
                .then(res => {
                    if (!res.ok) {
                        return res.text().then(text => {
                            try {
                                const errJson = JSON.parse(text);
                                throw new Error(errJson.message || 'Server returned ' + res.status);
                            } catch (e) {
                                throw new Error('HTTP ' + res.status + ' Error');
                            }
                        });
                    }
                    return res.json();
                })
                .then(data => {
                    if (data.success && data.item) {
                        globalSelectedUrl = data.item.url;
                        document.getElementById('pickerSelectedUrlText').innerText = 'Uploaded & Selected: ' + data.item.url.split('/').pop();
                        document.getElementById('pickerSelectBtn').disabled = false;
                    } else if (data.message) {
                        alert("Upload notice: " + data.message);
                    }
                })
                .catch(err => alert("Upload error: " + err.message));
            };
            reader.readAsDataURL(file);
        }
    }

    function confirmPickerSelection() {
        if (globalSelectedUrl && typeof globalPickerCallback === 'function') {
            globalPickerCallback(globalSelectedUrl);
            closeMediaPicker();
        }
    }
</script>
